---
import "../styles/global.css";
import { stegaClean } from "@sanity/client/stega";
import { getSiteSettings } from "../lib/queries";
import { getClient, isPreviewRequest, urlFor } from "../lib/sanity";
import VisualEditing from "../components/VisualEditing.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import V2CookieBanner from "../components/V2CookieBanner.astro";
import LocaleSuggestionBanner from "../components/LocaleSuggestionBanner.astro";
import { v } from "../lib/asset-url";
import { LOCALE_LABELS, alternateLinks, localeFromPath, normalizePath, stripLocale } from "../lib/i18n";

interface SeoBlock {
  metaTitle?: string;
  metaDescription?: string;
  ogImage?: { asset?: { _ref: string } };
  noIndex?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: { asset?: { _ref: string } };
  seo?: SeoBlock;
  /** Override canonical URL — defaults to current page path */
  canonical?: string;
  /**
   * Nav theme. "dark" = transparent glass over a dark hero (homepage, ICP
   * pages). "light" = solid white from page top (interior pages, legal,
   * forms). Default "light".
   */
  navTheme?: "dark" | "light";
  /**
   * Extra class on <body>. The v2 marketing pages pass "v2": global.css is
   * imported by this layout and therefore bundled AFTER any page-linked
   * stylesheet, so its `.container` / `.btn` rules would otherwise beat the
   * identically-specific v2 ones. All v2 CSS is scoped under `body.v2`, which
   * raises specificity above global.css regardless of bundle order. Set
   * server-side (not via a client script) so there's no layout flash.
   */
  bodyClass?: string;
  /**
   * When false, the page ships its own chrome: BaseLayout skips the site
   * nav, footer, and the <main> wrapper (the page body is injected as-is).
   * Used by the v2 homepage, which carries its own capsule nav, loader,
   * cursor, and footer. Default true.
   */
  chrome?: boolean;
  /**
   * Absolute (or root-relative) URL of a static OG/Twitter card image,
   * bypassing the Sanity-image pipeline. Highest precedence — use for a
   * page that ships its own hand-made share card (e.g. the v2 homepage's
   * /v2/og-brain.png). Root-relative paths are resolved against the site
   * origin so crawlers get an absolute URL. Ignored if a Sanity `seo.ogImage`
   * is set, which stays the editor-controlled source of truth.
   */
  ogImageUrl?: string;
  /**
   * Emit BreadcrumbList structured data. Default true for every page except the
   * site root. Set false on a page that builds its own richer trail — currently
   * only insights/[slug].astro, which appends the article title from Sanity.
   * Two BreadcrumbLists on one page is a validation error, not a bonus.
   */
  breadcrumb?: boolean;
}

const {
  title, description, ogImage, seo, canonical,
  navTheme = "light", chrome = true, bodyClass, ogImageUrl: ogImageUrlProp,
  breadcrumb = true,
} = Astro.props;
const previewMode = isPreviewRequest(Astro);
const settings = await getSiteSettings(getClient(Astro));

// Compose final SEO values: page-specific seo block wins, then page-level
// props, then site-wide defaults from settings.
const defaultSeo: SeoBlock = settings?.defaultSeo ?? {};

// Strip stega zero-width characters from <title> and <meta> values. Stega
// encoding is fine for visible text inside the Studio iframe (the visual-
// editing overlay decodes it), but browsers display the zero-width chars
// as raw text in <title> bars and search engines treat them as part of
// the title. stegaClean is a no-op on plain strings.
const finalTitle = stegaClean(
  seo?.metaTitle ?? title ?? defaultSeo.metaTitle ?? "Team — The Operating System for Music Releases"
);
const finalDescription = stegaClean(
  seo?.metaDescription ?? description ?? defaultSeo.metaDescription ?? "Stop juggling spreadsheets, Slack threads, and email chains. One platform for your entire rollout."
);
const siteOrigin = (Astro.site ?? new URL("https://teamrollouts.com")).origin;
const finalOgImage = seo?.ogImage ?? ogImage ?? defaultSeo.ogImage;
// Precedence: Sanity image (editor-controlled) → static ogImageUrl prop →
// site-wide default. Root-relative prop paths are absolutized for crawlers.
const ogImageUrl = finalOgImage?.asset?._ref
  ? urlFor(finalOgImage).width(1200).height(630).fit("crop").url()
  : ogImageUrlProp
    ? new URL(ogImageUrlProp, siteOrigin).toString()
    : "https://teamrollouts.com/og-image.png";

const noIndex = seo?.noIndex === true || previewMode;
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.site ?? "https://teamrollouts.com").toString();

/**
 * Locale, never from the visitor's country — see src/lib/i18n.ts for why.
 *
 * Falls back to deriving it from the path rather than to DEFAULT_LOCALE,
 * because middleware DOES NOT RUN FOR PRERENDERED PAGES. Any page that opts
 * into `export const prerender = true` gets no `locals`, so defaulting to
 * English would silently render a Korean page as `lang="en"` with no error
 * anywhere — correct-looking output, wrong to every screen reader and crawler.
 * Deriving from the path makes middleware an optimisation rather than a
 * requirement, so the two paths cannot disagree.
 */
const locale = Astro.locals?.locale ?? localeFromPath(Astro.url.pathname);
const basePath = Astro.locals?.basePath ?? stripLocale(Astro.url.pathname);
const htmlLang = LOCALE_LABELS[locale].hreflang;

/**
 * hreflang alternates. Emitted only for paths with a published translation, so
 * an alternate can never point at a 404 — Google discards a whole annotation
 * cluster when one link is broken, so a partial set is worse than none.
 *
 * Suppressed in two cases:
 *  - noindex (which includes every preview render): telling a crawler "here are
 *    this page's language versions" while also telling it not to index the page
 *    is a contradiction, and preview renders would leak draft URLs.
 *  - an explicit `canonical` prop: the page is deliberately pointing somewhere
 *    else, so alternates derived from ITS path would annotate the wrong cluster.
 */
const hreflangAlternates =
  noIndex || canonical ? [] : alternateLinks(normalizePath(Astro.url.pathname), siteOrigin);

/**
 * BreadcrumbList — emitted here rather than per page so every route gets one and
 * none can be forgotten. Derived from the URL path, with a label map because
 * de-slugging gives the wrong words ("For artists", "Sms terms") and a breadcrumb
 * that reads differently from the nav is worse than none.
 *
 * Nested paths build the full trail, so /insights/<slug> would produce
 * Home > Insights > <slug>. The article page passes breadcrumb={false} and emits
 * its own, using the real title from Sanity instead of the slug.
 */
const CRUMB_LABELS: Record<string, string> = {
  rollouts: "Rollouts", teammate: "TeamMate", assets: "Assets",
  connections: "Connections", tours: "Tours", security: "Security & trust",
  pricing: "Pricing", about: "About", contact: "Contact", insights: "Insights",
  enterprise: "Enterprise", changelog: "Changelog",
  "for-artists": "Solo artists", "for-managers": "Managers",
  "for-labels": "Labels", "for-partners": "Distributors",
  privacy: "Privacy", terms: "Terms", cookies: "Cookies", "sms-terms": "SMS Terms",
};
const crumbSegments = Astro.url.pathname.replace(/^\/|\/$/g, "").split("/").filter(Boolean);
const siteRoot = (Astro.site ?? new URL("https://teamrollouts.com")).origin;
const breadcrumbJsonLd =
  breadcrumb && crumbSegments.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: `${siteRoot}/` },
          ...crumbSegments.map((seg, i) => ({
            "@type": "ListItem",
            position: i + 2,
            name: CRUMB_LABELS[seg] ?? seg.replace(/-/g, " "),
            item: `${siteRoot}/${crumbSegments.slice(0, i + 1).join("/")}`,
          })),
        ],
      }
    : null;

/* The <html> tag below carries data-theme="dark", which HOLDS THE SITE'S DARK
   LOCK — don't remove it casually. The v2 design ships a real light theme keyed
   off BOTH `:root[data-theme="light"]` AND
   `@media(prefers-color-scheme:light) :root:not([data-theme="dark"])`.
   Shipping light is deferred as its own feature (it needs a toggle, and the
   interior pages' CSS has no light variants at all), so this attribute — the
   source's own opt-out — pins every page dark regardless of the visitor's OS.
   It is load-bearing: homepage-v2.css carries those light blocks, so without it
   a light-mode visitor got a LIGHT homepage (cream ground under a nav logo
   force-inverted to white) while every other page stayed dark. When the toggle
   is built, this becomes its default value.

   KEEP `<!doctype html>` IMMEDIATELY ADJACENT TO `<html>`: putting anything
   between them — even an Astro template comment — breaks Astro's whole-document
   detection, and it then silently emits the page with NO html and NO head
   element at all, dropping lang="en" with them. That shipped once. Which is why
   this note lives up here in the frontmatter instead of down there. */
---
<!doctype html>
<html lang={htmlLang} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{finalTitle}</title>
  <meta name="description" content={finalDescription} />
  {noIndex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalUrl} />
  {hreflangAlternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
  {breadcrumbJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )}

  <!-- Open Graph -->
  <meta property="og:title" content={finalTitle} />
  <meta property="og:description" content={finalDescription} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={finalTitle} />
  <meta name="twitter:description" content={finalDescription} />
  <meta name="twitter:image" content={ogImageUrl} />

  {/* Font/CDN preconnects REMOVED (2026-08-12). All five were dead weight:
      - fonts.googleapis.com / fonts.gstatic.com: the v2 fonts are self-hosted
        from /v2/assets/fonts (see the @font-face block in v2-base.css), and
        neither host is referenced anywhere outside this file. Preconnecting to
        Google Fonts also discloses every visitor's IP to Google for no benefit,
        which matters now that we ask for consent.
      - cdn.simpleicons.org / svgl.app / cdn.jsdelivr.net: warmed for the old
        integrations marquee, which only exists in homepage-body.html — the
        PRE-v2 homepage body that no live route imports. The v2 marquee serves
        its logos first-party from /v2/assets/logos.
      A preconnect to a host you never call costs a DNS lookup and a TLS
      handshake per page and buys nothing. */}

  {/*
    Scroll position preservation across Visual Editing reloads.
    @sanity/astro's VisualEditing wrapper triggers window.location.reload()
    on every keystroke when the editor is typing in Studio's right panel,
    which jolts the iframe back to the top. Preserving scroll into
    sessionStorage on unload + restoring on load makes the reload nearly
    invisible — the editor sees the headline change in place while the
    page actually refreshes underneath.

    Only runs in preview mode (no point burning sessionStorage budget
    for ordinary visitors), and uses a generated key per-path so two
    different pages don't restore each other's scroll.
  */}
  {previewMode && (
    <script is:inline>{`
      (function () {
        var key = 'sve-scroll:' + location.pathname;
        try {
          var saved = sessionStorage.getItem(key);
          if (saved !== null) {
            var y = parseInt(saved, 10);
            if (!isNaN(y) && y > 0) {
              // Restore on next paint after layout settles
              window.addEventListener('load', function () {
                window.scrollTo(0, y);
              });
            }
          }
        } catch (e) {}
        window.addEventListener('beforeunload', function () {
          try { sessionStorage.setItem(key, String(window.scrollY)); } catch (e) {}
        });
      })();
    `}</script>
  )}

  {/*
    PostHog — same project as the app (app.teamrollouts.com) and the in-repo
    marketing partials (server/marketing/partials/head.ts), so marketing-site
    pageviews land alongside product events. Anonymous-only on the marketing
    site; identify() runs only post-login in the SPA. Set $host as a super
    property so dashboards can split "marketing" vs "app" traffic when needed.
    Emitted unconditionally (outside the chrome guard) so the chromeless v2
    homepage is tracked too.
  */}
  <script is:inline set:html={`
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    /* COOKIELESS UNTIL CONSENT. persistence:'memory' means no cookie and no
       cross-session identity, matching what the app already does in
       client/src/lib/posthog.ts. Before this, the marketing site initialised
       with default (cookie) persistence plus autocapture and pageview capture,
       so it set the ph_* cookie on first paint with no consent collected
       anywhere — the app asked, the marketing site never did. */
    posthog.init('phc_rbP43MvbYyuKY4snFXECD7QA5qyUZd9dsVu89pWnf7wC',{api_host:'https://us.i.posthog.com',autocapture:true,capture_pageview:true,capture_pageleave:true,persistence:'memory',disable_session_recording:true});
    posthog.register({ surface: 'marketing', site: 'team-website' });

    /* Upgrade to persistent storage only once analytics consent exists.
       The consent record is a COOKIE scoped to .teamrollouts.com, not
       localStorage: localStorage is origin-scoped, so apex, www and
       app.teamrollouts.com would each have prompted separately. One cookie on
       the parent domain covers all three, and it survives Safari's 7-day cap on
       script-writable storage better than localStorage does. Keep the name and
       shape in sync with the app's useCookieConsent. */
    try {
      var m = document.cookie.match(/(?:^|;\\s*)cookie_consent=([^;]*)/);
      if (m) {
        var c = JSON.parse(decodeURIComponent(m[1]));
        if (c && c.analytics) posthog.set_config({ persistence: 'localStorage+cookie' });
      }
    } catch (e) { /* malformed cookie → stay cookieless, which is the safe side */ }
  `} />

  {/* Chromeless pages ship their own nav/footer — the site chrome CSS
      would fight them (nav.css sets overflow-x:hidden on html/body, which
      also breaks position:sticky pinning). */}
  <!-- Nav + footer CSS hoisted to head to prevent FOUC of large unstyled
       logo + plain-text link list when navigating between pages. -->
  {chrome && <link rel="stylesheet" href={v("/components/nav.css")} />}
  {chrome && <link rel="stylesheet" href={v("/components/footer.css")} />}

  <!-- Critical nav layout — inlined as a defensive measure so the nav
       NEVER renders unstyled even if /components/nav.css is delayed by
       cache misses or the CDN. Mirrors the layout-only rules from
       nav.css; full visual styling still comes from the linked file. -->
  {chrome && <style is:inline>
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 0.875rem 2rem; display: flex; align-items: center; justify-content: space-between; max-width: 80rem; margin: 0 auto; }
    .nav__pill { display: flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.5rem; border-radius: 100px; background: rgba(255,255,255,0.12); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.1); }
    .nav__logo { display: flex; align-items: center; padding: 0 0.5rem; position: relative; }
    .nav__logo img { height: 1.125rem; }
    .nav__logo .logo-light { position: absolute; }
    .nav__logo .logo-dark { opacity: 0; }
    .nav__link, .nav__login { font-size: 0.8125rem; font-weight: 500; padding: 0.5rem 0.875rem; border-radius: 100px; color: rgba(255,255,255,0.85); white-space: nowrap; display: inline-flex; align-items: center; gap: 0.25rem; text-decoration: none; }
    .nav__login { padding: 0.5rem 1rem; border: 1px solid rgba(255,255,255,0.3); }
    .nav__cta { display: inline-flex; align-items: center; justify-content: center; font-size: 0.8125rem; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 100px; color: #fff; background: #111110; text-decoration: none; white-space: nowrap; }
    .nav__divider { width: 1px; height: 1rem; background: rgba(255,255,255,0.15); margin: 0 0.125rem; }
    .nav__dropdown { position: relative; }
    .nav__dropdown-panel { position: absolute; top: calc(100% + 0.75rem); left: 0; opacity: 0; visibility: hidden; pointer-events: none; }
    .nav__dropdown.is-open .nav__dropdown-panel { opacity: 1; visibility: visible; pointer-events: auto; }
    .nav__status { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; padding: 0.375rem 0.625rem; border-radius: 100px; color: rgba(255,255,255,0.85); text-decoration: none; }
    .nav__status-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }
    .nav__burger { display: none; }
    .nav-mobile, .nav-mobile-overlay { display: none; }
    .nav a { text-decoration: none; }
    .nav a svg { fill: none; stroke: currentColor; }
  </style>}

  <slot name="head" />
</head>
<body class={bodyClass}>
  {/*
    Legacy nav + footer — both auto-inject their CSS and build their own DOM
    into the placeholder divs below. data-theme controls nav appearance:
    "dark" = transparent over hero, "light" = solid from top of page.

    Source: components/nav.js + components/footer.js (copied to public/components/
    so Astro serves them at /components/*.js). Single source of truth lives
    in the legacy files for now; future work could migrate nav links into
    Sanity's siteSettings.navGroups but the legacy scripts are battle-tested.
  */}
  {/*
    Inject siteSettings as a global before nav.js / footer.js execute.
    `defer` runs scripts in document order after parsing, so the inline
    JSON below is guaranteed to be set before nav.js reads it. Each
    component falls back to its hardcoded structure when the global is
    absent or empty (rendering with `__TEAM_SITE__ = null` is a no-op).
  */}
  <script is:inline set:html={`window.__TEAM_SITE__ = ${JSON.stringify(settings ?? null)};`} />

  {chrome ? (
    <>
      <div id="team-nav" data-theme={navTheme}>
        <Nav settings={settings} theme={navTheme} />
      </div>

      <main>
        <slot />
      </main>

      <Footer settings={settings} />

      <script src={v("/components/nav.js")} defer></script>
    </>
  ) : (
    <slot />
  )}

  {/*
    Visual Editing overlay — always mount so Studio's Presentation tool
    can establish its postMessage connection with the iframe. Without
    stega encoding on public pages (sanityClient has stega disabled),
    the overlay has nothing to attach to outside Studio, so public
    visitors never see hover pencils or "Failed to decode stega"
    errors. Inside the iframe, the preview client emits stega and the
    overlay attaches pencils as expected.
  */}
  {/* Outside the `chrome` guard on purpose: consent is not site chrome, and
      the chromeless v2 pages (the homepage especially) load PostHog too. */}
  <V2CookieBanner />

  {/* Also outside the `chrome` guard, and for the same reason: the chromeless
      v2 homepage is precisely the page a visitor from Korea lands on first.
      Renders nothing unless the current path has a published translation. */}
  <LocaleSuggestionBanner locale={locale} basePath={basePath} />

  <VisualEditing />
</body>
</html>
