---
/**
 * Insight article — v2, restyled from
 * team-july2026-multipager/insights/<slug>.html.
 *
 * Like the index, this is a RESTYLE, not an injection port: the article bodies
 * live in Sanity as Portable Text (migrated by scripts/import-insights-v2.mjs)
 * and are rendered by PortableText.astro, which already handles the h2/h3/
 * blockquote/list/link/image set the imported bodies use. Only the surrounding
 * markup and styling move to v2.
 *
 * getInsightPostSlugs() deliberately includes `hiddenFromIndex` posts, so the
 * SEO/GEO pages still build and stay indexable — they're just absent from the
 * index listing.
 *
 * BlogPosting + BreadcrumbList JSON-LD per HANDOFF §8, built from the Sanity
 * fields so it can't drift from what's rendered.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import V2Head from "../../components/V2Head.astro";
import V2Nav from "../../components/V2Nav.astro";
import V2Footer from "../../components/V2Footer.astro";
import PortableText from "../../components/PortableText.astro";
import { getInsightPostSlugs, getInsightPostBySlug } from "../../lib/queries";
import { getClient, urlFor } from "../../lib/sanity";
import { v } from "../../lib/asset-url";

export async function getStaticPaths() {
  const slugs = await getInsightPostSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getInsightPostBySlug(slug as string, getClient(Astro));

if (!post) return Astro.redirect("/insights");

function formatDate(d?: string) {
  if (!d) return "";
  return new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

const SITE = "https://teamrollouts.com";
const url = `${SITE}/insights/${slug}`;
const heroUrl = post.heroImage?.asset
  ? urlFor(post.heroImage).width(1200).format("webp").url()
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.title,
      description: post.excerpt,
      datePublished: post.publishDate,
      dateModified: post._updatedAt ?? post.publishDate,
      author: { "@type": "Person", name: post.authorName ?? "Team" },
      publisher: { "@type": "Organization", name: "Team", url: SITE },
      mainEntityOfPage: url,
      ...(heroUrl ? { image: heroUrl } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Insights", item: `${SITE}/insights` },
        { "@type": "ListItem", position: 3, name: post.title, item: url },
      ],
    },
  ],
};
---
<BaseLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.heroImage}
  seo={post.seo}
  chrome={false}
  bodyClass="v2"
>
  <V2Head slot="head" pageCss="/components/v2-prose.css" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <V2Nav active="resources" />

  <main id="main">
    <article class="post container">
      <a class="post__back" href="/insights">← Back to Insights</a>
      {post.category?.title && <span class="post__cat">{post.category.title}</span>}
      <h1 class="post__title">{post.title}</h1>
      <div class="post__meta">
        <span>By {post.authorName ?? "Team"}</span><span class="dot"></span>
        <span>{formatDate(post.publishDate)}</span>
        {post.readMinutes && (
          <>
            <span class="dot"></span>
            <span>{post.readMinutes} min read</span>
          </>
        )}
      </div>

      {heroUrl && <img class="post__hero" src={heroUrl} alt="" loading="lazy" />}

      <div class="prose">
        <PortableText value={post.body} />
      </div>
    </article>

    <section class="section container">
      <div class="pfinal reveal">
        <h2 class="h2">Run your next release <em>on a brain.</em></h2>
        <div class="ctaband__row">
          <a class="btn btn--solid" href="/pricing">Sign up free</a>
          <a class="btn btn--ghost" href="https://calendly.com/teamrollouts-demo/30min" target="_blank" rel="noopener">
            Book a demo <span class="btn__arr">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
</BaseLayout>
