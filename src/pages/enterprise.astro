---
/**
 * Enterprise — v2, ported from team-july2026-multipager/enterprise.html.
 *
 * Injection port (HANDOFF §A.5). This page has NO inline <style> of its own —
 * all of its styling comes from the shared css/solutions.css, ported to
 * public/components/v2-solutions.css.
 *
 * Scripts, matching the source's own <script> tags:
 *   v2-brain.js      — ambient point-cloud canvas backdrop (self-mounting;
 *                      v2-base.css only applies the legibility scrim when
 *                      .brain-bg is present, which is why this page gets it
 *                      and /pricing doesn't)
 *   v2-solutions.js  — ledger/section reveal behaviour
 *
 * NOT Sanity-bound yet (HANDOFF §A.8: hardcode first, model after). The
 * `enterprisePage` schema + document are untouched; only `seo` is read.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { getEnterprisePage } from "../lib/queries";
import { getClient } from "../lib/sanity";
import { v } from "../lib/asset-url";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/v2-enterprise-body.html?raw";

const page = await getEnterprisePage(getClient(Astro));

const TITLE = "For enterprise — the brain for your operation, at your scale | Team";
const DESCRIPTION =
  "For labels and distributors at scale: org-wide deployment, the controls procurement expects, and one operational picture across every release.";
---
<BaseLayout title={TITLE} description={DESCRIPTION} seo={page?.seo} chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-solutions.css" />

  <V2Nav active="solutions" />

  <Fragment set:html={bodyHtml} />

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/v2-brain.js")}></script>
  <script is:inline src={v("/components/v2-solutions.js")}></script>
</BaseLayout>
