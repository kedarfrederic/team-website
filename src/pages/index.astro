---
/**
 * Homepage — v2 "A brain for music operations" (2026-07-10).
 *
 * The page was designed and built as a self-contained static build
 * (hand-tuned scroll choreography: pinned acts, a 3D point-cloud brain
 * canvas, scrub-driven scenes, no frameworks), so rather than
 * transcribing it into Astro components we inject it whole — the same
 * strategy the previous homepage used in its Phase 5.2 port:
 *
 *   1. Styles:  public/components/homepage-v2.css
 *   2. Script:  public/components/homepage-v2.js  (one rAF loop, no libs)
 *   3. Body:    src/lib/homepage-v2-body.html injected via set:html
 *   4. Assets:  public/v2/assets/** (fonts, logos, imagery)
 *
 * The page carries its own loader, equalizer cursor, footer and the
 * `.capsule` scroll narrator (progress ring + current act, pinned
 * top-right), so BaseLayout renders chromeless (chrome={false}): no
 * classic nav/footer, no <main> wrapper (the body brings its own).
 * BaseLayout still owns SEO, canonical, OG tags, and the Visual
 * Editing mount.
 *
 * It DOES render the shared V2Nav, matching the delivered design: the
 * source's index.html loads js/chrome.js, which injects the site nav
 * unconditionally, so the homepage has both the site nav and the
 * capsule. Without it the homepage had ZERO internal links — every
 * other page was unreachable from the front door.
 *
 * The beta signup form posts straight to the CRM
 * (admin.getteamnow.com/api/v1/website-leads, source_form='beta') —
 * teamrollouts.com is on that endpoint's CORS allowlist.
 *
 * The previous (Sanity-hybrid) homepage remains intact at /home-classic
 * for rollback and comparison; its Sanity schemas and components are
 * untouched, ready to be layered into this page section-by-section as
 * follow-up work.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { v } from "../lib/asset-url";
import { getHomepage } from "../lib/queries";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/homepage-v2-body.html?raw";

// ── Sanity-bound copy ────────────────────────────────────────
// Only the high-churn hero + beta copy is editable; every token below falls
// back to the string shipped in homepage-v2-body.html, so an empty or
// unreachable CMS renders the page exactly as designed. Uses the published
// (CDN) client — copy updates go live on publish, not draft — which also
// keeps stega encoding out of the raw HTML we inject via set:html.
const page = await getHomepage();
const heroV2 = page?.heroV2 ?? {};
const betaV2 = page?.betaV2 ?? {};

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

// NOTE these fallbacks are what actually renders today: every heroV2/betaV2
// field in Sanity is currently null, so the CMS binding is inert and editing a
// fallback here IS the live change. Keep scripts/seed-homepage-v2-copy.ts in
// sync, or a future seed would push the older copy back over the top.
//
// Every token below must exist in homepage-v2-body.html. A token defined here
// but absent from the body is silently a no-op, which is how V2_BETA_SUBMIT
// outlived the form it labelled — reconcile both lists after any re-port.
const tokens: Record<string, unknown> = {
  "{{V2_HERO_EYEBROW}}": heroV2.eyebrow ?? "Meet Team.",
  "{{V2_HERO_TITLE_LEAD}}": heroV2.titleLead ?? "A",
  "{{V2_HERO_TITLE_EM}}": heroV2.titleEmphasis ?? "brain",
  "{{V2_HERO_TITLE_TAIL}}": heroV2.titleTail ?? "for music operations.",
  // heroV2.subhead is intentionally NOT bound: the delivered copy carries an
  // inline <br class="bp-md"> responsive break, and esc() below would render
  // that tag as visible text. The subhead is literal in the body instead.
  "{{V2_CTA_PRIMARY}}": heroV2.primaryCtaLabel ?? "Sign up free",
  "{{V2_CTA_SECONDARY}}": heroV2.secondaryCtaLabel ?? "Book a walkthrough",
  "{{V2_BETA_TITLE_LEAD}}": betaV2.titleLead ?? "Try it on your",
  "{{V2_BETA_TITLE_EM}}": betaV2.titleEmphasis ?? "next release.",
  "{{V2_BETA_SUBHEAD}}":
    betaV2.subhead ?? "Rollouts and Assets, free forever — no card required.",
  // V2_BETA_SUBMIT removed with the beta signup form — /pricing is the
  // self-serve path now and the homepage posts nothing to the CRM.
};

let body = bodyHtml as string;
for (const [token, value] of Object.entries(tokens)) {
  body = body.split(token).join(esc(value));
}

/**
 * Homepage structured data — ported from the source's index.html.
 *
 * The site had ZERO JSON-LD on the homepage. Organization + WebSite give search
 * engines the entity and the publisher relationship; SoftwareApplication is what
 * makes this legible as a product rather than a brochure; WebPage ties the page
 * to both. @id values are stable fragment URIs so the nodes can reference each
 * other, which is how the source does it.
 *
 * TWO DELIBERATE DEPARTURES FROM THE SOURCE:
 *
 * 1. `logo` points at /v2/assets/… . The source says /assets/logo/…, which is
 *    correct in that repo's layout and a 404 here — a broken logo URL in
 *    structured data is worse than none, because it's what search surfaces pull.
 *
 * 2. The AggregateOffer block is OMITTED. The source declares
 *    highPrice "49.95", but our live /pricing advertises figures up to $99.95
 *    after the base-plus-seat cutover. Price markup that contradicts the page is
 *    a real risk (search engines can display it), and I can't infer from the page
 *    alone which figure is the per-month ceiling versus a yearly total. Add it
 *    back once someone confirms the exact tier prices — the shape is in the
 *    source, it just needs correct numbers.
 *
 * `dateModified` is also dropped rather than hardcoded: the source pins
 * 2026-08-07, which is already stale, and a date asserted here that nobody
 * updates is misinformation with a timestamp.
 */
const SITE = "https://teamrollouts.com";
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Team",
      alternateName: "Team Rollouts",
      url: `${SITE}/`,
      logo: `${SITE}/v2/assets/logo/team-logomark-black.png`,
      description: "The operational brain for music releases.",
      sameAs: [
        "https://www.instagram.com/teamrollouts/",
        "https://x.com/Teamrollouts",
        "https://www.linkedin.com/company/teamrollouts",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: `${SITE}/`,
      name: "Team",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      name: "Team",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: `${SITE}/`,
      description:
        "Team connects the tools your music operation already runs on — releases, assets, and tours — and adds TeamMate, an AI layer that reasons across all of it.",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE}/#webpage`,
      url: `${SITE}/`,
      name: "Team — A Brain for Music Operations",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#organization` },
    },
  ],
};
---

<BaseLayout
  title="Team — A Brain for Music Operations"
  description="Team is the operational brain for music companies, artist teams, and modern music businesses. It connects the systems your operation already runs on and turns them into one living intelligence layer."
  ogImageUrl="/v2/og-brain.png"
  navTheme="dark"
  chrome={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(homeJsonLd)} />
  {/* woff2, matching what homepage-v2.css now @font-face's. The delivered CSS
      moved to woff2; preloading the old .woff/.ttf would have fetched files the
      page never uses while the real fonts waited on CSS parse. */}
  <link slot="head" rel="preload" href="/v2/assets/fonts/NyghtSerif-LightItalic.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href="/v2/assets/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="stylesheet" href={v("/components/v2-chrome.css")} />
  <link slot="head" rel="stylesheet" href={v("/components/homepage-v2.css")} />

  <V2Nav />

  <Fragment set:html={body} />

  {/* The delivered index.html ends with a minimal inline footer carrying no
      links at all, so the homepage was the one page with no route to Privacy,
      Terms or SMS terms. Render the shared footer the interior pages use; the
      inline one is hidden in homepage-v2.css. */}
  <V2Footer />

  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/homepage-v2.js")}></script>
</BaseLayout>
