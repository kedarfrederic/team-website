---
/**
 * Homepage — v2 "A brain for music operations" (2026-07-10).
 *
 * The page was designed and built as a self-contained static build
 * (hand-tuned scroll choreography: pinned acts, a 3D point-cloud brain
 * canvas, scrub-driven scenes, no frameworks), so rather than
 * transcribing it into Astro components we inject it whole — the same
 * strategy the previous homepage used in its Phase 5.2 port:
 *
 *   1. Styles:  public/components/homepage-v2.css
 *   2. Script:  public/components/homepage-v2.js  (one rAF loop, no libs)
 *   3. Body:    src/lib/homepage-v2-body.html injected via set:html
 *   4. Assets:  public/v2/assets/** (fonts, logos, imagery)
 *
 * The page carries its own loader, equalizer cursor, footer and the
 * `.capsule` scroll narrator (progress ring + current act, pinned
 * top-right), so BaseLayout renders chromeless (chrome={false}): no
 * classic nav/footer, no <main> wrapper (the body brings its own).
 * BaseLayout still owns SEO, canonical, OG tags, and the Visual
 * Editing mount.
 *
 * It DOES render the shared V2Nav, matching the delivered design: the
 * source's index.html loads js/chrome.js, which injects the site nav
 * unconditionally, so the homepage has both the site nav and the
 * capsule. Without it the homepage had ZERO internal links — every
 * other page was unreachable from the front door.
 *
 * The beta signup form posts straight to the CRM
 * (admin.getteamnow.com/api/v1/website-leads, source_form='beta') —
 * teamrollouts.com is on that endpoint's CORS allowlist.
 *
 * The previous (Sanity-hybrid) homepage remains intact at /home-classic
 * for rollback and comparison; its Sanity schemas and components are
 * untouched, ready to be layered into this page section-by-section as
 * follow-up work.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import V2Nav from "../components/V2Nav.astro";
import { v } from "../lib/asset-url";
import { getHomepage } from "../lib/queries";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/homepage-v2-body.html?raw";

// ── Sanity-bound copy ────────────────────────────────────────
// Only the high-churn hero + beta copy is editable; every token below falls
// back to the string shipped in homepage-v2-body.html, so an empty or
// unreachable CMS renders the page exactly as designed. Uses the published
// (CDN) client — copy updates go live on publish, not draft — which also
// keeps stega encoding out of the raw HTML we inject via set:html.
const page = await getHomepage();
const heroV2 = page?.heroV2 ?? {};
const betaV2 = page?.betaV2 ?? {};

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const tokens: Record<string, unknown> = {
  "{{V2_HERO_EYEBROW}}": heroV2.eyebrow ?? "Meet Team.",
  "{{V2_HERO_TITLE_LEAD}}": heroV2.titleLead ?? "A",
  "{{V2_HERO_TITLE_EM}}": heroV2.titleEmphasis ?? "brain",
  "{{V2_HERO_TITLE_TAIL}}": heroV2.titleTail ?? "for music operations.",
  "{{V2_HERO_SUBHEAD}}":
    heroV2.subhead ??
    "Team connects the systems your music operation already runs on, turning every tool, file, message, plan, and data point into one living intelligence layer.",
  "{{V2_CTA_PRIMARY}}": heroV2.primaryCtaLabel ?? "Join the beta",
  "{{V2_CTA_SECONDARY}}": heroV2.secondaryCtaLabel ?? "Book a walkthrough",
  "{{V2_BETA_TITLE_LEAD}}": betaV2.titleLead ?? "Try it on your",
  "{{V2_BETA_TITLE_EM}}": betaV2.titleEmphasis ?? "next release.",
  "{{V2_BETA_SUBHEAD}}": betaV2.subhead ?? "The Team beta program is now open. Sign up today.",
  "{{V2_BETA_SUBMIT}}": betaV2.submitLabel ?? "Sign me up",
};

let body = bodyHtml as string;
for (const [token, value] of Object.entries(tokens)) {
  body = body.split(token).join(esc(value));
}
---

<BaseLayout
  title="Team — A Brain for Music Operations"
  description="Team is the operational brain for music companies, artist teams, and modern music businesses. It connects the systems your operation already runs on and turns them into one living intelligence layer."
  ogImageUrl="/v2/og-brain.png"
  navTheme="dark"
  chrome={false}
>
  <link slot="head" rel="preload" href="/v2/assets/fonts/NyghtSerif-LightItalic.woff" as="font" type="font/woff" crossorigin />
  <link slot="head" rel="preload" href="/v2/assets/fonts/Inter-Variable.ttf" as="font" type="font/ttf" crossorigin />
  <link slot="head" rel="stylesheet" href={v("/components/v2-chrome.css")} />
  <link slot="head" rel="stylesheet" href={v("/components/homepage-v2.css")} />

  <V2Nav />

  <Fragment set:html={body} />

  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/homepage-v2.js")}></script>
</BaseLayout>
