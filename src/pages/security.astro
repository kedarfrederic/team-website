---
/**
 * Security & trust — v2, ported from team-july2026-multipager/security.html.
 *
 * Injection port, same strategy as the v2 homepage and per that repo's
 * HANDOFF.md §A.5: the page's <body> markup moves across whole
 * (src/lib/v2-security-body.html) and its <head> <style> becomes
 * public/components/v2-security.css.
 *
 * NOT Sanity-bound yet. HANDOFF §A.8 says to hardcode first and model the
 * editable bits afterwards, starting with insights + pricing (both done). The
 * previous version of this page was bound to the `securityPage` singleton, so
 * that editability is temporarily lost here — the schema and its document are
 * untouched and still in Sanity, ready to bind section-by-section. Only the
 * SEO block is still read, so editors keep control of title/description.
 *
 * Chrome: BaseLayout with chrome={false} + the delivered V2Nav/V2Footer.
 * `active="platform"` mirrors the source's <body data-nav="platform">.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { getSecurityPage } from "../lib/queries";
import { getClient } from "../lib/sanity";
import { v } from "../lib/asset-url";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/v2-security-body.html?raw";

const page = await getSecurityPage(getClient(Astro));

const TITLE = "Security & trust — your releases, your data, your rules | Team";
const DESCRIPTION =
  "Team sits on your whole operation, so trust is the unlock — encryption, permissioned revocable connections, and AI that never trains on your data.";
---
<BaseLayout title={TITLE} description={DESCRIPTION} seo={page?.seo} chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-security.css" />

  <V2Nav active="platform" />

  <Fragment set:html={bodyHtml} />

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
</BaseLayout>
