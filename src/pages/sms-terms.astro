---
/**
 * SMS Terms — v2 restyle.
 *
 * This page is NOT from team-july2026-multipager: the delivered design has no
 * SMS terms page. It's an old-site page kept deliberately (it's the SMS
 * compliance document, referenced by the app's messaging opt-in), and it was
 * still rendering the classic light chrome long after every other page moved to
 * v2 — visibly the old site, reachable from the new footer.
 *
 * A restyle, NOT a change to the operative terms: the copy is the same text
 * already published, moved out of Tailwind utility classes into the shared
 * `.legal` + `.prose` shell that /privacy and /terms use. Two incidental fixes
 * came with it:
 *   - the "Privacy Policy" link was an absolute https://teamrollouts.com/privacy
 *     URL, now root-relative like every other internal link, so it stays on the
 *     current origin (it broke local and preview navigation).
 *   - the body carried a JSX `{" "}` space expression, which is meaningless in a
 *     raw HTML body and rendered literally; replaced with a real space.
 *
 * The old page's ~50-line scoped <style> block is gone: it restyled h1/h2/p/
 * strong for a light theme, which v2-prose.css already does for dark.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { v } from "../lib/asset-url";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/v2-sms-terms-body.html?raw";
---
<BaseLayout
  title="SMS Terms | Team"
  description="Terms for account-related and customer support text messages sent by Team. SMS is optional, never marketing, and you can reply STOP at any time."
  chrome={false}
  bodyClass="v2"
>
  <V2Head slot="head" pageCss="/components/v2-sms-terms.css" />
  <link slot="head" rel="stylesheet" href={v("/components/v2-prose.css")} />

  <V2Nav />

  <Fragment set:html={bodyHtml} />

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
</BaseLayout>
