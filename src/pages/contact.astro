---
/**
 * Contact — v2, ported from team-july2026-multipager/contact.html.
 *
 * Injection port (HANDOFF §A.5): body markup → src/lib/v2-contact-body.html,
 * inline <style> → public/components/v2-contact.css, inline submit script →
 * public/components/v2-contact.js.
 *
 * NOT Sanity-bound yet — HANDOFF §A.8 says hardcode first, model afterwards.
 * The `contactPage` schema + document are untouched in Sanity, ready to bind;
 * only the SEO block is read so editors keep title/description control.
 *
 * The form POSTs to the CRM (source_form:'contact'). No V2Nav `active` is
 * passed: Contact isn't a top-level nav item in the delivered design (it lives
 * in the footer), so nothing should be highlighted — the source's
 * <body data-nav="contact"> has no matching nav group either.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { getContactPage } from "../lib/queries";
import { getClient } from "../lib/sanity";
import { v } from "../lib/asset-url";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/v2-contact-body.html?raw";

const page = await getContactPage(getClient(Astro));

const TITLE = "Contact — talk to the team | Team";
const DESCRIPTION =
  "Have a question, want a walkthrough, or want to bring your label onto Team? Tell us what you're looking for and we'll get back to you.";
---
<BaseLayout title={TITLE} description={DESCRIPTION} seo={page?.seo} chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-contact.css" />

  <V2Nav />

  <Fragment set:html={bodyHtml} />

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/v2-contact.js")}></script>
</BaseLayout>
