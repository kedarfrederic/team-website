---
/**
 * Insights index — v2, restyled from team-july2026-multipager/insights.html.
 *
 * NOT an injection port, unlike the other v2 pages. The insight content already
 * lives in Sanity (migrated by scripts/import-insights-v2.mjs), so this page
 * keeps reading from Sanity and only the MARKUP + styling move to v2. Injecting
 * static HTML here would have thrown away the CMS binding editors rely on for
 * publishing posts.
 *
 * Category chips are derived from the posts actually present rather than
 * hardcoded, so a chip can never filter to an empty set and a new category
 * appears on its own.
 *
 * `hiddenFromIndex` posts are excluded upstream by getInsightPosts() — they
 * keep a real, indexable page but stay off this list.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { getInsightsIndexPage, getInsightPosts } from "../lib/queries";
import { getClient } from "../lib/sanity";
import { v } from "../lib/asset-url";

const client = getClient(Astro);
const [page, posts] = await Promise.all([
  getInsightsIndexPage(client),
  getInsightPosts(client),
]);

interface Post {
  _id: string;
  title: string;
  slug: { current: string };
  excerpt?: string;
  publishDate?: string;
  readMinutes?: number;
  category?: { title?: string; slug?: { current?: string } };
}

const all: Post[] = Array.isArray(posts) ? posts : [];

function formatDate(d?: string) {
  if (!d) return "";
  return new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

// Chips come from the data, in first-appearance order (posts are already
// newest-first), so they always match what's on the page.
const cats: { slug: string; title: string }[] = [];
for (const p of all) {
  const s = p.category?.slug?.current;
  const t = p.category?.title;
  if (s && t && !cats.some((c) => c.slug === s)) cats.push({ slug: s, title: t });
}

const searchPlaceholder = page?.search?.placeholder ?? "Search posts...";
const TITLE = page?.seo?.metaTitle ?? "Insights | Team";
const DESCRIPTION =
  page?.seo?.metaDescription ??
  "Playbooks, release strategy and how the best music teams actually ship.";
---
<BaseLayout title={TITLE} description={DESCRIPTION} seo={page?.seo} chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-prose.css" />

  <V2Nav active="resources" />

  <main id="main">
    <section class="phero container" id="top">
      <div class="phero__in">
        <h1 class="h1"><em>Insights.</em></h1>
      </div>
    </section>

    <section class="section container">
      <div class="itools reveal">
        <div class="ichips">
          <button class="ichip on" data-cat="all" type="button">All</button>
          {cats.map((c) => (
            <button class="ichip" data-cat={c.slug} type="button">{c.title}</button>
          ))}
        </div>
        <label class="isearch">
          <input type="search" id="isearch" placeholder={searchPlaceholder} aria-label="Search posts" />
        </label>
      </div>

      <div class="igrid" id="igrid">
        {all.map((p) => (
          <a
            class="icard reveal"
            href={`/insights/${p.slug.current}`}
            data-cat={p.category?.slug?.current ?? ""}
            data-search={`${p.title} ${p.excerpt ?? ""}`.toLowerCase()}
          >
            <div class="icard__top">
              <span class="icard__cat">{p.category?.title}</span>
              {p.readMinutes && <span class="icard__read">{p.readMinutes} min</span>}
            </div>
            <h2 class="icard__title">{p.title}</h2>
            <p class="icard__excerpt">{p.excerpt}</p>
            <div class="icard__foot">
              <span>{formatDate(p.publishDate)}</span>
              <span class="icard__arrow">→</span>
            </div>
          </a>
        ))}
      </div>
      <p class="iempty" id="iempty" hidden>No posts match that yet.</p>
    </section>
  </main>

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/v2-insights.js")}></script>
</BaseLayout>
