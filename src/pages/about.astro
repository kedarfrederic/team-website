---
/**
 * About — v2, ported from team-july2026-multipager/about.html.
 *
 * Injection port (HANDOFF §A.5): body → src/lib/v2-about-body.html, inline
 * <style> → public/components/v2-about.css.
 *
 * Loads TWO extra stylesheets/scripts beyond the shared foundation, matching
 * the source's own tags:
 *   v2-app-preview.css/.js — the "#devband" product-UI mockup (live countdown,
 *                            tasks landing on the timeline, TeamMate chat).
 *                            The markup ships in the body; the JS only runs
 *                            while #devband is in view.
 *   v2-story.js            — the scroll storytelling sequence.
 *
 * NOT Sanity-bound yet (HANDOFF §A.8: hardcode first, model after). The
 * `aboutPage` schema + document are untouched; only `seo` is read.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { getAboutPage } from "../lib/queries";
import { getClient } from "../lib/sanity";
import { v } from "../lib/asset-url";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/v2-about-body.html?raw";

const page = await getAboutPage(getClient(Astro));

const TITLE = "About — building the operational brain for music | Team";
const DESCRIPTION =
  "We built Team because the most important work in music — getting a release out — still runs on spreadsheets, group chats and memory.";
---
<BaseLayout title={TITLE} description={DESCRIPTION} seo={page?.seo} chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-about.css" />
  <link slot="head" rel="stylesheet" href={v("/components/v2-app-preview.css")} />

  <V2Nav active="resources" />

  <Fragment set:html={bodyHtml} />

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/v2-story.js")}></script>
  <script is:inline src={v("/components/v2-app-preview.js")}></script>
</BaseLayout>
