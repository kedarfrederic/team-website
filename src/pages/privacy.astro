---
/**
 * Privacy Policy — v2, ported from team-july2026-multipager/privacy.html.
 *
 * Legal copy is byte-for-byte the same text already published — verified by
 * diffing the live page against the source (99.3%+ identical; the only
 * differences were "Teammate" -> "TeamMate" capitalisation and Cloudflare's
 * email obfuscation on the live HTML). This is a restyle, NOT a change to the
 * operative terms. The previous version of this page was hardcoded too, so no
 * Sanity editability is lost.
 *
 * Injection port (HANDOFF §A.5). Long-form prose styling comes from the shared v2-prose.css.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import V2Head from "../components/V2Head.astro";
import V2Nav from "../components/V2Nav.astro";
import V2Footer from "../components/V2Footer.astro";
import { v } from "../lib/asset-url";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../lib/v2-privacy-body.html?raw";
---
<BaseLayout title="Privacy Policy | Team" description="How Team Rollouts, Inc. collects, uses, shares, and protects information when you use Team." chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-privacy.css" />
  <link slot="head" rel="stylesheet" href={v("/components/v2-prose.css")} />

  <V2Nav />

  <Fragment set:html={bodyHtml} />

  <V2Footer />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
</BaseLayout>
