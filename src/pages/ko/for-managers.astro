---
/**
 * For artist managers — Korean.
 *
 * Mirrors src/pages/for-managers.astro. The page's argument is about ATTENTION — the
 * release that slips is the one you weren't watching — so the Korean keeps that
 * as the through-line rather than flattening it into "manage everything in one
 * place", which is what a literal pass produces and which loses the point.
 *
 * v2-solutions.js writes only animated counter digits: no hidden copy.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import V2Head from "../../components/V2Head.astro";
import V2Nav from "../../components/V2Nav.astro";
import V2Footer from "../../components/V2Footer.astro";
import KoreanTypography from "../../components/KoreanTypography.astro";
import { v } from "../../lib/asset-url";
import { localizePage } from "../../lib/koLocalize";
import { KO_FOR_MANAGERS } from "../../lib/ko/for-managers";
// @ts-expect-error — Astro's ?raw modifier returns a string at build time
import bodyHtml from "../../lib/v2-for-managers-body.html?raw";

const TITLE = "아티스트 매니저를 위한 Team — 로스터 전체를 한곳에";
const DESCRIPTION =
  "Team은 아티스트마다 각자의 브레인을 두고 로스터 전체를 한 화면에 유지합니다. 다른 아티스트에 집중하는 동안에도 놓치는 일이 없도록.";

const body = localizePage(bodyHtml as string, KO_FOR_MANAGERS, "ko");
---
<BaseLayout title={TITLE} description={DESCRIPTION} chrome={false} bodyClass="v2">
  <V2Head slot="head" pageCss="/components/v2-solutions.css" />
  <KoreanTypography />

  <V2Nav active="solutions" locale="ko" />

  <Fragment set:html={body} />

  <V2Footer locale="ko" />

  <script is:inline src={v("/components/v2-base.js")}></script>
  <script is:inline src={v("/components/v2-chrome.js")}></script>
  <script is:inline src={v("/components/v2-brain.js")}></script>
  <script is:inline src={v("/components/v2-solutions.js")}></script>
</BaseLayout>
