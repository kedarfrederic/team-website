---
/**
 * Pricing page — v2 ("free platform, Pro brain") ported from
 * team-july2026-multipager/pricing.html. Same Sanity-bound fallback
 * pattern as every other page: every value below falls back to the
 * exact copy shipped in the source, so an empty CMS renders unchanged.
 *
 * Design: dark, matching the v2 homepage — chrome stays on (Nav/Footer),
 * navTheme="dark" so the pill nav never flips to its solid/light state
 * (nav.js only adds nav--solid for theme==="light"; dark pages keep the
 * frosted-on-dark look for their whole scroll length, which is correct
 * here since the page is dark all the way down, not just in a hero).
 *
 * The final-CTA section is hidden per the source ("hidden for now per
 * Simon") — kept as a hardcoded display:none, not a CMS toggle, since
 * that's the author's own current call, not persistent site content.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SplitHeadline from "../components/SplitHeadline.astro";
import { getPricingPage } from "../lib/queries";
import { getClient } from "../lib/sanity";
import { toHTML } from "@portabletext/to-html";
import { v } from "../lib/asset-url";

const page = await getPricingPage(getClient(Astro));

const hero = page?.hero ?? {};
const heroHeadlineTop = hero.headlineTop ?? hero.headline ?? "Start free.";
const heroHeadlineBottom = hero.headlineBottom ?? "Upgrade when you're ready.";
const heroSubhead =
  hero.subhead ??
  "Team gives you access to Rollouts and Assets for free, forever. Ready to go further? Pro adds Tours, TeamMate — your AI brain — and connects your whole stack.";
const heroNote = hero.note ?? "Take advantage of our limited-time Beta pricing today";

// Distinct from the hero lede — the source ships a separate, shorter meta
// description tuned for SERP/social. Sanity `seo.metaDescription` still wins.
const metaDescription =
  "The Team platform — Rollouts and Assets — is free, no card. Pro adds Tours, TeamMate AI, and connects your whole stack, at beta pricing.";

const billingToggle = page?.billingToggle ?? {};
const yearlyLabel = billingToggle.yearlyLabel ?? "Yearly";
const monthlyLabel = billingToggle.monthlyLabel ?? "Monthly";
const yearlySaveTag = billingToggle.yearlySaveTag ?? "Save ~20%";

interface Tier {
  tierKey: string;
  name: string;
  who?: string;
  monthlyPrice?: string;
  yearlyPrice?: string;
  priceWasMonthly?: string;
  priceWasYearly?: string;
  seatsIncludedNote?: string;
  extraSeatPriceMonthly?: string;
  extraSeatPriceYearly?: string;
  extraSeatWasMonthly?: string;
  extraSeatWasYearly?: string;
  /** Period label for the YEARLY price (e.g. "/mo · billed yearly", "forever"). */
  period?: string;
  /**
   * Period label for the MONTHLY price (e.g. "/mo"). Falls back to `period`.
   * Must be set whenever the yearly label names the billing cycle — otherwise
   * selecting Monthly renders "/mo · billed yearly", which contradicts itself
   * and misstates the billing terms.
   */
  periodMonthly?: string;
  ctaLabel: string;
  ctaHref: string;
  includesLabel?: string;
  /**
   * Either a plain string (the original schema shape, still what the live
   * Sanity document holds) or a `tierFeature` object that can flag a Pro-only
   * line for the ✦ bullet. normalizeFeatures() below accepts both — reading
   * `.text` off a plain string silently renders an EMPTY bullet, so never
   * index into these without normalizing first.
   */
  features?: (string | { text?: string; pro?: boolean })[];
  badge?: string;
}

function normalizeFeatures(
  features: Tier["features"]
): { text: string; pro: boolean }[] {
  return (features ?? [])
    .map((f) =>
      typeof f === "string"
        ? { text: f, pro: false }
        : { text: f?.text ?? "", pro: !!f?.pro }
    )
    .filter((f) => f.text.length > 0);
}

const rawTiers = Array.isArray(page?.tiers) ? page.tiers : [];
const tiers: Tier[] =
  rawTiers.length > 0
    ? rawTiers
    : [
        {
          tierKey: "free",
          name: "Free",
          who: "The core platform, designed for every artist, manager and team",
          monthlyPrice: "$0",
          yearlyPrice: "$0",
          period: "forever",
          seatsIncludedNote: "1 seat · unlimited artists, releases & collaborators",
          ctaLabel: "Start for free",
          ctaHref: "https://app.teamrollouts.com/onboarding?plan=free",
          includesLabel: "Includes",
          features: [
            { text: "Rollouts — release management" },
            { text: "Assets — the creative library" },
            { text: "Unlimited artists & releases" },
            { text: "Unlimited collaborators & workspaces" },
          ],
        },
        {
          tierKey: "pro",
          name: "Pro",
          who: "For teams who want to connect the whole stack",
          monthlyPrice: "$49.95",
          yearlyPrice: "$39.96",
          priceWasMonthly: "$99.95",
          priceWasYearly: "$79.96",
          period: "/mo · billed yearly",
          periodMonthly: "/mo",
          seatsIncludedNote: "Includes 2 seats",
          extraSeatWasMonthly: "$39.95",
          extraSeatWasYearly: "$31.96",
          extraSeatPriceMonthly: "$29.95/mo",
          extraSeatPriceYearly: "$23.96/mo",
          badge: "Beta pricing · ~50% off",
          ctaLabel: "Start 14-day free trial",
          ctaHref: "https://app.teamrollouts.com/onboarding?plan=pro",
          includesLabel: "Everything in Free, plus",
          features: [
            { text: "Tours — tour management", pro: true },
            { text: "TeamMate AI — the intelligence layer", pro: true },
            { text: "Connections — connect your whole stack", pro: true },
            { text: "TeamMate Email & Text", pro: true },
            { text: "First access to new betas", pro: true },
            { text: "Priority support", pro: true },
          ],
        },
      ];

interface ComparisonCell {
  type: "check" | "dash" | "text";
  text?: string;
}
interface ComparisonRow {
  label: string;
  isGroupHeader?: boolean;
  tooltip?: string;
  valueByColumn?: ComparisonCell[];
}

const comparisonTable = page?.comparisonTable ?? {};
const compareHeadTop = "Compare";
const compareHeadBottom = "Free & Pro.";
const compareColumns: string[] =
  Array.isArray(comparisonTable.columns) && comparisonTable.columns.length > 0
    ? comparisonTable.columns
    : ["Free", "Pro"];

const compareRows: ComparisonRow[] =
  Array.isArray(comparisonTable.rows) && comparisonTable.rows.length > 0
    ? comparisonTable.rows
    : [
        { label: "The platform", isGroupHeader: true },
        { label: "Rollouts — release management", valueByColumn: [{ type: "check" }, { type: "check" }] },
        { label: "Assets — creative library", valueByColumn: [{ type: "check" }, { type: "check" }] },
        { label: "Tours — tour management", valueByColumn: [{ type: "dash" }, { type: "check" }] },
        { label: "Artists / roster", valueByColumn: [{ type: "text", text: "Unlimited" }, { type: "text", text: "Unlimited" }] },
        { label: "Releases", valueByColumn: [{ type: "text", text: "Unlimited" }, { type: "text", text: "Unlimited" }] },
        { label: "Collaborators", valueByColumn: [{ type: "text", text: "Unlimited" }, { type: "text", text: "Unlimited" }] },
        { label: "Workspaces", valueByColumn: [{ type: "text", text: "Unlimited" }, { type: "text", text: "Unlimited" }] },
        { label: "Seats included", valueByColumn: [{ type: "text", text: "1" }, { type: "text", text: "2, then per seat" }] },
        { label: "The brain — Pro", isGroupHeader: true },
        { label: "TeamMate AI", valueByColumn: [{ type: "dash" }, { type: "check" }] },
        { label: "Connections", valueByColumn: [{ type: "dash" }, { type: "check" }] },
        { label: "TeamMate Email & Text", valueByColumn: [{ type: "dash" }, { type: "check" }] },
        { label: "Comprehensive intelligence", valueByColumn: [{ type: "dash" }, { type: "check" }] },
        { label: "First access to new betas", valueByColumn: [{ type: "dash" }, { type: "check" }] },
        { label: "Support", valueByColumn: [{ type: "text", text: "Standard" }, { type: "text", text: "Priority" }] },
      ];

interface FaqItem {
  question: string;
  answer: any;
}

const faq = page?.faq ?? {};
const faqHeadlineTop = faq.headlineTop ?? faq.headline ?? "Questions?";
const faqHeadlineBottom = faq.headlineBottom ?? "We've got answers.";
const faqCtaHref = "https://calendly.com/teamrollouts-demo/30min";
const faqCtaLabel = faq.footerCta?.label ?? "Talk to a founder";

const faqFallback = [
  { q: "Is the platform really free?", a: "Yes. Rollouts and Assets are free — unlimited artists, releases, collaborators and workspaces, with no card. It's the real platform, not a stripped-down taster." },
  { q: "What's in Pro?", a: "Pro adds Tours, TeamMate — your AI brain — plus the integrations that connect your whole stack, TeamMate Email & Text, comprehensive intelligence, and first access to new betas." },
  { q: "What's this \"beta pricing\"?", a: "Team is in early access, so Pro is offered at a beta discount off its standard price. Sign up now and you lock in that early-access rate. Both plans start with a 14-day free trial." },
  { q: "Do I need a card to start?", a: "Not for Free — it's no card, ever. Pro starts with a 14-day free trial and takes a card so it can continue seamlessly if you stay." },
  { q: "Is my data mine?", a: "Always. Connections are permissioned and revocable, nothing is used to train models, and everything you build is portable and exportable." },
];

const faqItems: { q: string; aHtml: string }[] =
  Array.isArray(faq.items) && faq.items.length > 0
    ? faq.items.map((it: FaqItem) => ({
        q: it.question,
        aHtml: Array.isArray(it.answer) ? toHTML(it.answer) : "",
      }))
    : faqFallback.map((it) => ({ q: it.q, aHtml: `<p>${it.a}</p>` }));

// FAQPage structured data mirrors the rendered FAQ items exactly.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.aHtml.replace(/<[^>]+>/g, "") },
  })),
};

const finalCta = page?.finalCta ?? {};
const finalHeadlineTop = finalCta.headlineTop ?? finalCta.headline ?? "Run your next release";
const finalHeadlineBottom = finalCta.headlineBottom ?? "on Team, for free.";
const finalPrimary = finalCta.primaryCta ?? { label: "Start for free", href: "https://app.teamrollouts.com/onboarding?plan=free" };
const finalSecondary = finalCta.secondaryCta ?? { label: "Book a demo", href: "https://calendly.com/teamrollouts-demo/30min" };
const finalFootnote = finalCta.footnote ?? "Free platform · no card required";
---
<BaseLayout
  title="Pricing — free platform, Pro brain | Team"
  description={metaDescription}
  seo={page?.seo}
  navTheme="dark"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd)} />
  <link slot="head" rel="stylesheet" href={v("/components/pricing-v2.css")} />

  <main id="main">
    <section class="phero container">
      <div class="phero__in">
        <SplitHeadline as="h1" class="h1 reveal" top={heroHeadlineTop} bottom={heroHeadlineBottom} />
        <p class="lede reveal" style="transition-delay:.08s;margin-inline:auto">{heroSubhead}</p>
        <p class="phero__note reveal" style="transition-delay:.14s">{heroNote}</p>
        <div class="bill reveal" id="bill" role="tablist" aria-label="Billing period" style="transition-delay:.2s">
          <button class="on" data-period="yearly" role="tab" type="button">{yearlyLabel} <span class="save">{yearlySaveTag}</span></button>
          <button data-period="monthly" role="tab" type="button">{monthlyLabel}</button>
        </div>
      </div>
    </section>

    <section class="section container" style="padding-top:0">
      <div class="plans reveal">
        {tiers.map((tier) => {
          const isPro = tier.tierKey !== "free" && tiers.length > 1 && tier === tiers[tiers.length - 1];
          const hasSeatOverage = !!(tier.extraSeatPriceYearly || tier.extraSeatPriceMonthly);
          return (
            <div class={`plan${isPro ? " plan--pro" : ""}`}>
              {tier.badge && <span class="plan__badge">{tier.badge}</span>}
              <p class="plan__name">{tier.name}</p>
              <p class="plan__who">{tier.who}</p>
              <div class="plan__price">
                {(tier.priceWasYearly || tier.priceWasMonthly) && (
                  <span class="plan__was" data-yearly={tier.priceWasYearly} data-monthly={tier.priceWasMonthly}>{tier.priceWasYearly ?? tier.priceWasMonthly}</span>
                )}
                <span class="plan__amount" data-yearly={tier.yearlyPrice} data-monthly={tier.monthlyPrice}>{tier.yearlyPrice ?? tier.monthlyPrice}</span>
                <span class="plan__period" data-yearly={tier.period} data-monthly={tier.periodMonthly ?? tier.period}>{tier.period ?? "/mo"}</span>
              </div>
              {tier.seatsIncludedNote && (
                <p class="plan__seat">
                  {tier.seatsIncludedNote}
                  {hasSeatOverage && (
                    <>
                      {" "}· then{" "}
                      <s data-yearly={tier.extraSeatWasYearly} data-monthly={tier.extraSeatWasMonthly}>{tier.extraSeatWasYearly ?? tier.extraSeatWasMonthly}</s>{" "}
                      <b data-yearly={tier.extraSeatPriceYearly} data-monthly={tier.extraSeatPriceMonthly}>{tier.extraSeatPriceYearly ?? tier.extraSeatPriceMonthly}</b> per extra seat
                    </>
                  )}
                </p>
              )}
              <p class="plan__note">{tier.tierKey === "free" ? "No card required." : "Cancel any time."}</p>
              <a class="btn btn--solid" href={tier.ctaHref} data-cta data-plan={tier.tierKey}>{tier.ctaLabel}</a>
              <p class="plan__inclab">{tier.includesLabel ?? "Includes"}</p>
              <ul class="plan__feats">
                {normalizeFeatures(tier.features).map((feat) => (
                  <li class={feat.pro ? "pro" : undefined}>{feat.text}</li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
      <p class="plans__compare reveal"><a class="txtlink" href="#compare"><span class="tl">Compare all features</span><span class="arr">→</span></a></p>
    </section>

    <section class="section container" id="compare">
      <div style="max-width:44rem;margin:0 auto 1rem;text-align:center" class="reveal">
        <SplitHeadline as="h2" class="h2" top={compareHeadTop} bottom={compareHeadBottom} />
      </div>
      <div class="ctable-wrap reveal">
        <table class="ctable">
          <thead>
            <tr>
              <th></th>
              {compareColumns.map((col, i) => (
                <th class={i === compareColumns.length - 1 && compareColumns.length > 1 ? "pro" : undefined}>{col}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) =>
              row.isGroupHeader ? (
                <tr class="grp"><td colspan={compareColumns.length + 1}>{row.label}</td></tr>
              ) : (
                <tr>
                  <td>{row.label}</td>
                  {(row.valueByColumn ?? []).map((cell) => {
                    if (cell.type === "check") return <td class="val"><span class="yes">✓</span></td>;
                    if (cell.type === "dash") return <td class="val"><span class="no">–</span></td>;
                    return <td class="val">{cell.text}</td>;
                  })}
                </tr>
              )
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section container">
      <div style="max-width:44rem;margin:0 auto 2.4rem;text-align:center" class="reveal">
        <SplitHeadline as="h2" class="h2" top={faqHeadlineTop} bottom={faqHeadlineBottom} />
      </div>
      <div class="faq reveal">
        {faqItems.map((item) => (
          <details>
            <summary>{item.q}<span class="pl"></span></summary>
            <div set:html={item.aHtml} />
          </details>
        ))}
      </div>
      <div class="faq__foot reveal">
        <a class="btn btn--ghost" href={faqCtaHref} target="_blank" rel="noopener">{faqCtaLabel} <span class="btn__arr">→</span></a>
      </div>
    </section>

    <section class="section container" style="display:none">
      <div class="pfinal reveal">
        <SplitHeadline as="h2" class="h2" top={finalHeadlineTop} bottom={finalHeadlineBottom} />
        <div class="ctaband__row">
          <a class="btn btn--solid" href={finalPrimary.href}>{finalPrimary.label}</a>
          {finalSecondary?.label && finalSecondary?.href && (
            <a class="btn btn--ghost" href={finalSecondary.href} target="_blank" rel="noopener">{finalSecondary.label} <span class="btn__arr">→</span></a>
          )}
        </div>
        {finalFootnote && <p class="pfinal__note">{finalFootnote}</p>}
      </div>
    </section>
  </main>

  <script is:inline src={v("/components/pricing-v2.js")}></script>
</BaseLayout>
