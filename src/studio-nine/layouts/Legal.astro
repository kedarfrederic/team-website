---
import Base from './Base.astro';
import meta from '../content/legal/meta.json';
interface Props { slug: keyof typeof meta; description: string; body: string; }
const { slug, description, body } = Astro.props;
const m = meta[slug];
const d = new Date(m.updated);
const updated = isNaN(d.getTime()) ? m.updated : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const legal = [['privacy','Privacy'],['terms','Terms'],['cookies','Cookies'],['sms-terms','SMS terms'],['security','Security']];
---
<Base title={m.title} description={description} theme="paper">
  <section class="lg">
    <div class="wrap">
      <header class="lg__head">
        <div>
          <h1 class="h1">{m.title}</h1>
          <p class="lg__upd">{m.updated && <><span class="lg__upd-k">Last updated</span><time datetime={isNaN(d.getTime()) ? "" : d.toISOString()}>{updated}</time></>}<span class="lg__upd-n">{m.toc.length} sections · about {Math.max(2, Math.round(body.split(' ').length / 220))} min read</span></p>
        </div>
        <nav class="lg__switch tabs tabs--paper" aria-label="Legal pages">{legal.map(([s, l], i) => <a class:list={['tab', { 'is-on': s === slug }]} style={`--c:${['var(--lime)','var(--team-mgmt)','var(--team-mkt)','var(--team-distro)','var(--team-press)'][i]}`} href={'/' + s}>{l}</a>)}</nav>
      </header>
      <div class="lg__body">
        <aside class="lg__toc">
          <p class="lg__toc-k">On this page</p>
          <ol>{m.toc.map(t => <li><a href={'#' + t.id}>{t.t.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
          <p class="lg__q">Questions? <a class="link" href="/contact">Contact us <span class="arr">→</span></a></p>
        </aside>
        <article class="lg__prose" set:html={body} />
      </div>
    </div>
  </section>
</Base>
<style is:global>
  .lg{padding:calc(4.5rem + clamp(2rem,5vw,4rem)) 0 var(--section)}
  .lg__head{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end;padding-bottom:2rem;border-bottom:1px solid var(--line);margin-bottom:clamp(2rem,4vw,3rem)}
  .lg__upd{display:inline-flex;align-items:center;gap:.7rem;flex-wrap:wrap;margin-top:1.1rem;padding:.45rem .5rem .45rem .9rem;border-radius:var(--r-pill);background:var(--white);border:1px solid var(--line);font-size:.88rem}
  .lg__upd-k{color:var(--ink-40)}
  .lg__upd time{font-weight:500;background:var(--lime);padding:.25rem .7rem;border-radius:var(--r-pill)}
  .lg__upd-n{color:var(--ink-40);padding-right:.4rem}
  .lg__body{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:clamp(2rem,5vw,5rem);align-items:start}
  .lg__toc{position:sticky;top:6rem;display:grid;gap:.9rem}
  .lg__toc-k{font-size:.74rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-40);font-weight:500}
  .lg__toc ol{display:grid;gap:.15rem;counter-reset:toc}
  .lg__toc li{counter-increment:toc}
  .lg__toc a{display:flex;gap:.6rem;font-size:.88rem;color:var(--ink-60);padding:.3rem .5rem;border-radius:.5rem;line-height:1.35;transition:background .2s,color .2s}
  .lg__toc a::before{content:counter(toc,decimal-leading-zero);font-variant-numeric:tabular-nums;color:var(--ink-40);font-size:.78rem;padding-top:.1rem}
  .lg__toc a:hover,.lg__toc a.is-on{background:var(--white);color:var(--ink)}
  .lg__q{font-size:.88rem;color:var(--ink-60);padding-top:.6rem;border-top:1px solid var(--line)}
  .lg__prose{max-width:44rem;min-width:0;background:var(--white);border-radius:var(--r-xl);padding:clamp(1.5rem,4vw,3.5rem);color:var(--ink-80);line-height:1.65;font-size:1.02rem}
  .lg__prose section+section{margin-top:2.5rem;padding-top:2.5rem;border-top:1px solid var(--line)}
  .lg__prose h2{font-size:1.5rem;font-weight:500;letter-spacing:-.02em;color:var(--ink);margin:0 0 1rem;scroll-margin-top:6rem}
  .lg__prose h3{font-size:1.05rem;font-weight:500;color:var(--ink);margin:1.5rem 0 .5rem}
  .lg__prose p{margin:0 0 1rem}
  .lg__prose ul,.lg__prose ol{padding-left:1.25rem;list-style:disc;margin:0 0 1rem;display:grid;gap:.4rem}
  .lg__prose ol{list-style:decimal}
  .lg__prose a{color:var(--ink);border-bottom:1px solid var(--ink-12)}
  .lg__prose strong{color:var(--ink);font-weight:500}
  .lg__prose table{width:100%;border-collapse:collapse;font-size:.92rem;margin:0 0 1rem;display:block;overflow-x:auto}
  .lg__prose th,.lg__prose td{text-align:left;padding:.6rem .5rem;border-bottom:1px solid var(--line);vertical-align:top}
  @media (max-width:900px){.lg__head,.lg__body{grid-template-columns:minmax(0,1fr)}.lg__toc{position:static}}
</style>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lg__toc a'));
  const hs = links.map(a => document.getElementById(a.getAttribute('href')!.slice(1))).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver((es) => { es.forEach(e => { if (e.isIntersecting) { links.forEach(a => a.classList.toggle('is-on', a.getAttribute('href') === '#' + e.target.id)); } }); }, { rootMargin: '-20% 0px -70% 0px' });
  hs.forEach(h => io.observe(h));
</script>
