---
import Base from './Base.astro';
interface Props { title: string; description?: string; updated?: string; }
const { title, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <section class="prose-page"><div class="wrap">
    <h1 class="h1">{title}</h1>
    {updated && <p class="micro">Last updated {updated}</p>}
    <div class="prose"><slot /></div>
  </div></section>
</Base>
<style is:global>
  .prose-page{padding:calc(4.5rem + clamp(2rem,5vw,4rem)) 0 var(--section)}
  .prose-page .h1{margin-bottom:.75rem}
  .prose{max-width:42rem;margin-top:2rem;display:grid;gap:1rem;color:var(--ink-80);line-height:1.65}
  .prose h2{font-size:1.4rem;font-weight:500;letter-spacing:-.02em;margin-top:1.25rem;color:var(--ink)}
  .prose ul{padding-left:1.2rem;list-style:disc;display:grid;gap:.4rem}
  .prose a{border-bottom:1px solid var(--ink-12)}
</style>
