---
// Photo frame with an interim image. The set is listed in TODO.md for replacement before launch.
interface Props { label: string; ratio?: string; shape?: 'round' | 'pill' | 'card' | 'circle'; tone?: 'warm' | 'cool' | 'lime' | 'ink'; class?: string; src?: string; pos?: string; }
const { label, ratio = '4 / 5', shape = 'card', tone = 'warm', class: cls = '', src, pos = 'center' } = Astro.props;
---
<figure class:list={['ph', `ph--${shape}`, `ph--${tone}`, cls]} style={`aspect-ratio:${ratio}`} aria-label={label}>
  {src && <img class="ph__img" src={src} alt="" loading="lazy" decoding="async" style={`object-position:${pos}`} />}
  <span class="ph__grain"></span>
  <slot />
</figure>
<style>
  .ph{position:relative;width:100%;overflow:hidden;margin:0;display:block;isolation:isolate}
  .ph--card{--ph-r:var(--r-xl);border-radius:var(--ph-r)}
  .ph--round{--ph-r:var(--r-photo);border-radius:var(--ph-r)}
  .ph--pill{--ph-r:999px;border-radius:var(--ph-r)}
  .ph--circle{--ph-r:2rem;border-radius:50%}
  .ph--warm{background:var(--ph-warm)}
  .ph--cool{background:var(--ph-cool)}
  .ph--lime{background:var(--ph-lime)}
  .ph--ink{background:var(--ph-ink)}
.ph__img{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;z-index:0}
  .ph:has(.ph__img) .ph__grain{display:none}
  .ph__grain{position:absolute;inset:0;opacity:.35;mix-blend-mode:multiply;background-image:radial-gradient(rgba(0,0,0,.08) 1px,transparent 1px);background-size:5px 5px;pointer-events:none}
</style>
