---
import { img } from '../../data/images';
const qa = [
  { q: "Where's the final master?", a: 'v10, Master_v10.wav. Approved by Maya in #audio on Tuesday. The one-sheet and the distributor brief both point at it.', src: [['dropbox','Dropbox'],['slack','Slack #audio'],['googledocs','One-sheet']], bg: 'var(--viv-green)', fg: 'var(--white)', who: img('hero-artist'), pos: 'center 35%', name: 'Ava', time: '09:12' },
  { q: "What's blocking Friday?", a: 'Two things. The vinyl PO needs your sign-off, and the video export is still rendering. Everything else for Friday is clear.', src: [['','Timeline'],['gmail','Gmail'],['googlecalendar','Calendar']], bg: 'var(--viv-lav)', fg: 'var(--ink)', who: img('hero-manager'), pos: 'center 30%', name: 'Theo', time: '14:40' },
  { q: 'Did we ever clear that sample?', a: 'Yes, cleared on 12 May. The licence is in the release folder and the credit is already in the metadata.', src: [['googledrive','Drive'],['','Metadata']], bg: 'var(--viv-pink)', fg: 'var(--ink)', who: img('hero-label'), pos: 'center 45%', name: 'Maya', time: '17:05' },
];
---
<section class="ask section" id="ask">
  <div class="wrap">
    <div class="head head--center">
      <h2 class="h1 lines"><span class="line"><span>Ask it anything</span></span><span class="line"><span>about the <em>release.</em></span></span></h2>
      <p class="lead" data-reveal style="margin-inline:auto">No more digging through six tools to prove something everyone vaguely remembers. Ask, and get a straight answer, and exactly where it came from.</p>
    </div>
    <div class="ask__grid" data-reveal-stagger="0.12">
      {qa.map((x) => (
        <article class="ask__card" style={`--bg:${x.bg};--fg:${x.fg}`}>
          <p class="ask__bar"><span><i class="ask__dots"></i>Midnight Static</span><span>{x.time}</span></p>
          <div class="ask__q">
            <span class="ask__av"><img src={x.who} alt="" loading="lazy" style={`object-position:${x.pos}`} /></span>
            <p><em>{x.q}</em></p>
          </div>
          <div class="ask__a">
            <span class="ask__tm"><span class="dot"></span>TeamMate</span>
            <p>{x.a}</p>
            <ul class="ask__src">{x.src.map(([ic, l]) => <li>{ic && <img src={`/studio-nine/logos/${ic}.svg`} alt="" loading="lazy" />}{!ic && <i class="ask__src-ic"></i>}{l}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .ask{background:var(--white)}
  .ask__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
  .ask__card{display:grid;grid-template-rows:auto auto 1fr;gap:1rem;background:var(--bg);color:var(--fg);border-radius:var(--r-xl);padding:1.1rem 1.1rem 1.1rem}
  .ask__bar{display:flex;justify-content:space-between;align-items:center;font-size:.74rem;font-weight:500;opacity:.8;padding:.1rem .2rem}
  .ask__bar span:first-child{display:flex;align-items:center;gap:.5rem}
  .ask__dots{width:.45rem;height:.45rem;border-radius:50%;background:currentColor;opacity:.6;box-shadow:.75rem 0 0 currentColor,1.5rem 0 0 currentColor;margin-right:1.5rem}
  .ask__q{display:flex;gap:.7rem;align-items:flex-end;padding:.2rem .2rem 0}
  .ask__av{flex:none;width:2.4rem;height:2.4rem;border-radius:50%;overflow:hidden;border:2px solid rgba(255,255,255,.7)}
  .ask__av img{width:100%;height:100%;object-fit:cover}
  .ask__q p{font-size:1.45rem;line-height:1.1;letter-spacing:-.02em;padding:.7rem .95rem;border-radius:calc(var(--r-xl) - 1.1rem);background:rgba(255,255,255,.92);color:var(--ink)}
  .ask__q em{font-family:var(--serif);font-weight:300;font-style:italic;font-size:1.12em}
  .ask__a{align-self:end;background:var(--ink);color:var(--on-dark);border-radius:calc(var(--r-xl) - 1.1rem);padding:1rem 1.1rem;display:grid;gap:.6rem;font-size:.95rem;line-height:1.45;margin-left:1.4rem}
  .ask__tm{display:flex;align-items:center;gap:.4rem;font-size:.76rem;font-weight:500;color:var(--on-dark-60)}
  .ask__a p{color:var(--white)}
  .ask__src{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.2rem}
  .ask__src li{display:inline-flex;align-items:center;gap:.35rem;font-size:.72rem;font-weight:500;padding:.3rem .6rem .3rem .45rem;border-radius:99px;background:var(--white);color:var(--ink)}
  .ask__src img{width:.9rem;height:.9rem}
  .ask__src-ic{width:.6rem;height:.6rem;border-radius:50%;background:var(--lime);margin:0 .15rem}
  @media (max-width:900px){.ask__grid{grid-template-columns:1fr}}
</style>
