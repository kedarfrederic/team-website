---
// "Your data stays yours": three promises with icon tiles, next to a permissions panel that shows the promises as controls.
const perms = [
  { ic: 'dropbox', n: 'Dropbox', s: '/Masters, /Artwork · read', on: true },
  { ic: 'slack', n: 'Slack', s: '#audio, #release-ops · read', on: true },
  { ic: 'googlesheets', n: 'Google Sheets', s: 'Budget · read and write', on: true },
  { ic: 'notion', n: 'Notion', s: 'Not connected', on: false },
];
---
<section class="trust section--tight">
  <div class="wrap">
    <div class="trust__card" data-reveal>
      <div class="trust__copy">
        <h2 class="h2">Your data <em>stays yours.</em></h2>
        <p class="lead">TeamMate reads your release to help you run it, and for nothing else.</p>
        <ul class="trust__list" data-reveal-stagger>
          <li><i class="trust__pi" style="--c:var(--viv-pink)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l16 16M9.9 5.1A7 7 0 0 1 19 12a7 7 0 0 1-.7 3M6.3 6.3A7 7 0 0 0 12 19a7 7 0 0 0 3.7-1M12 9v1M12 15v.1"/></svg></i><span><b>Never trains a model.</b> Not ours, not our providers'. Your masters, threads and numbers answer your questions and nothing more.</span></li>
          <li><i class="trust__pi" style="--c:var(--viv-cyan)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg></i><span><b>Permissioned and revocable.</b> You choose what Team can see, tool by tool, and can cut any of it off in a click.</span></li>
          <li><i class="trust__pi" style="--c:var(--lime)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M4 19h16"/></svg></i><span><b>Yours to keep.</b> Everything you build in Team is portable and exportable. No lock-in.</span></li>
        </ul>
        <a class="link trust__link" href="/security">How we keep it that way <span class="arr">→</span></a>
      </div>

      <div class="trust__panel" aria-hidden="true">
        <p class="trust__bar"><span><i class="trust__dots"></i>Your organisation</span><span class="trust__sealed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="10" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Sealed</span></p>
        <ul class="trust__perms">
          {perms.map(x => <li class:list={{ 'is-off': !x.on }}><span class="trust__logo"><img src={`/studio-nine/logos/${x.ic}.svg`} alt="" loading="lazy" /></span><span class="trust__pn"><b>{x.n}</b>{x.s}</span><i class:list={['trust__tog', { 'is-on': x.on }]}></i></li>)}
        </ul>
        <ul class="trust__facts">
          <li><b>Model training</b><em class="is-never">Never</em></li>
          <li><b>Shared with other customers</b><em class="is-never">Never</em></li>
          <li><b>Export everything</b><em>Any time</em></li>
        </ul>
      </div>
    </div>
  </div>
</section>
<style>
  .trust{background:var(--white);padding-bottom:var(--section)}
  .trust__card{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center;background:var(--dark);color:var(--on-dark);border-radius:var(--r-xl);padding:clamp(2rem,4.5vw,3.5rem)}
  .trust__copy{display:grid;gap:1.25rem}
  .trust__copy .lead{color:var(--on-dark-60)}
  .trust__list{display:grid;gap:.85rem;margin-top:.25rem}
  .trust__list li{display:grid;grid-template-columns:2.3rem 1fr;gap:.9rem;align-items:start;color:var(--on-dark-60);line-height:1.5}
  .trust__list b{color:var(--on-dark);font-weight:500}
  .trust__pi{width:2.3rem;height:2.3rem;border-radius:.75rem;background:var(--c);color:var(--ink);display:grid;place-items:center;margin-top:.05rem}
  .trust__pi svg{width:1.15rem;height:1.15rem}
  .trust__link{justify-self:start;color:var(--lime);border-color:rgba(217,250,135,.3)}
  .trust__link:hover{border-color:var(--lime)}
  /* the permissions panel */
  .trust__panel{background:var(--white);color:var(--ink);border-radius:calc(var(--r-xl) - 1.25rem);padding:1rem;display:grid;gap:.75rem;box-shadow:var(--shadow-lg)}
  .trust__bar{display:flex;justify-content:space-between;align-items:center;font-size:.78rem;font-weight:500;color:var(--ink-60);padding:.15rem .3rem}
  .trust__bar>span:first-child{display:flex;align-items:center;gap:.5rem}
  .trust__dots{width:.45rem;height:.45rem;border-radius:50%;background:var(--ink-12);box-shadow:.75rem 0 0 var(--ink-12),1.5rem 0 0 var(--ink-12);margin-right:1.5rem}
  .trust__sealed{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .6rem;border-radius:var(--r-pill);background:var(--viv-green);color:var(--white);font-size:.72rem;font-weight:600}
  .trust__sealed svg{width:.8rem;height:.8rem}
  .trust__perms{display:grid;gap:.4rem}
  .trust__perms li{display:grid;grid-template-columns:2.2rem 1fr auto;gap:.7rem;align-items:center;padding:.6rem .7rem;border-radius:.8rem;background:var(--paper)}
  .trust__perms li.is-off{opacity:.55}
  .trust__logo{width:2.2rem;height:2.2rem;border-radius:.6rem;background:var(--white);display:grid;place-items:center;border:1px solid var(--line)}
  .trust__logo img{width:1.15rem;height:1.15rem}
  .trust__pn{display:grid;font-size:.74rem;color:var(--ink-60);min-width:0}
  .trust__pn b{font-size:.86rem;font-weight:500;color:var(--ink)}
  .trust__tog{width:2rem;height:1.15rem;border-radius:1rem;background:var(--ink-12);position:relative}
  .trust__tog::after{content:'';position:absolute;top:.15rem;left:.15rem;width:.85rem;height:.85rem;border-radius:50%;background:var(--white);box-shadow:var(--shadow-sm)}
  .trust__tog.is-on{background:var(--viv-green)}.trust__tog.is-on::after{left:auto;right:.15rem}
  .trust__facts{display:grid;gap:.35rem;padding:.3rem .2rem 0;border-top:1px solid var(--line);padding-top:.7rem}
  .trust__facts li{display:flex;justify-content:space-between;align-items:center;font-size:.82rem}
  .trust__facts b{font-weight:450}
  .trust__facts em{font-style:normal;font-size:.72rem;font-weight:600;padding:.2rem .55rem;border-radius:.4rem;background:var(--lime);color:var(--ink)}
  .trust__facts em.is-never{background:var(--ink);color:var(--white)}
  @media (max-width:900px){.trust__card{grid-template-columns:1fr}}
</style>
