---
import { site } from '../../data/site';
import { img } from '../../data/images';
// Scenario loop: a circular photo, the person's message in serif, TeamMate typing, then outcome cards.
const SCENE_MS = 7600;  // one scene, shared by the dot fill and the advance timer
const scenes = [
  { k:'artist', who:'Ava · artist', photo: img('hero-artist'), pos:'center 35%', msg:'Album out 30 October. Ten tracks, no plan yet.', reply:'On it. Building the rollout from today to release day.', cards:[ { k:'Plan', v:'22', s:'tasks · 41 days', d:'+ built' }, { k:'Ready to roll', v:'0<small>/6</small>', s:'we\'ll get there', d:'' } ] },
  { k:'manager', who:'Theo · manager', photo: img('hero-manager'), pos:'center 30%', msg:'Four artists, nine releases, and I\'m on a plane.', reply:'Three things need you today. Everything else is handled.', cards:[ { k:'Roster', v:'9', s:'releases · live', d:'↗ on track' }, { k:'Needs you', v:'3', s:'decisions today', d:'' } ] },
  { k:'label', who:'Maya · label', photo: img('hero-label'), pos:'center 45%', msg:'Where does the Q3 slate actually stand?', reply:'Nine releases, seven on track. Atlas and Kite clash in week three.', cards:[ { k:'On track', v:'7<small>/9</small>', s:'Q3 slate', d:'↗ +2' }, { k:'Clashes', v:'1', s:'flagged early', d:'' } ] },
  { k:'partner', who:'Sam · distributor', photo: img('hero-partner'), pos:'center 45%', msg:'Forty deliveries this month. Which ones are late?', reply:'Thirty-eight are clean. Two need a nudge, and one nudge has already gone.', cards:[ { k:'Deliveries', v:'38<small>/40</small>', s:'metadata clean', d:'↗ 95%' }, { k:'Chasing', v:'2', s:'asked this morning', d:'' } ] },
];
---
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__copy">
      <h1 class="display lines">
        <span class="line"><span>Every release</span></span>
        <span class="line"><span>needs a <em>Team.</em></span></span>
      </h1>
      <p class="lead" data-reveal style="transition-delay:.25s">Team is the home of the release: the plan, the files, the money, the dates and the people in one place. Free for artists, managers and labels. Switch to Pro, and gain additional access to TeamMate, Connectors, and more.</p>
      <div class="cta-row" data-reveal style="transition-delay:.35s">
        <a class="btn btn--hero" href={site.cta.primary.href}>{site.cta.primary.label} <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
        <a class="btn btn--ghost btn--lg" href={site.cta.secondary.href}>{site.cta.secondary.label}</a>
      </div>
      <p class="cta-note" data-reveal style="transition-delay:.45s">No card. Nothing to migrate. Your first release is set up in minutes.</p>
    </div>

    <div class="hero__media" data-reveal style="transition-delay:.2s" data-hero-loop>
      <div class="hero__frame">
        <div class="hero__circle" data-hero-drag>
        {scenes.map((s, i) => <img class:list={['hero__photo', { 'is-on': i === 0 }]} src={s.photo} alt="" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position:${s.pos}`} data-scene-photo={i} />)}
        <div class="hero__chat">
          <div class="hero__tabs"><span class="is-on">Chat</span><span>Release</span></div>
          <div class="hero__bubble" data-bubble>
            <span class="hero__av" data-av></span>
            <p class="hero__msg" data-msg></p>
          </div>
          <div class="hero__typing" data-typing><i></i><i></i><i></i></div>
          <div class="hero__reply" data-reply><span class="dot"></span><p data-reply-text></p></div>
          </div>
        </div>
      <div class="hero__cards" data-cards-layout="0">
        {[0,1].map(j => (
          <div class:list={['hero__card', j === 0 ? 'hero__card--a' : 'hero__card--b']} data-out={j}>
            <p class="hero__card-k"><span data-out-k></span><span class="hero__card-d" data-out-d></span></p>
            <p class="hero__card-v tnum" data-out-v></p>
            <p class="hero__card-s" data-out-s></p>
          </div>
        ))}
        </div>
      </div>
      <div class="hero__dots" role="tablist" aria-label="Choose a scenario" style={`--scene:${SCENE_MS}ms`}>
        {scenes.map((sc, i) => <button class:list={['hero__dot', { 'is-on': i === 0 }]} type="button" role="tab" data-hero-dot={i} aria-label={sc.who} aria-selected={i === 0 ? 'true' : 'false'}></button>)}
      </div>
    </div>
  </div>
  <script type="application/json" id="hero-scenes" set:html={JSON.stringify(scenes.map(s => ({ who: s.who, msg: s.msg, reply: s.reply, cards: s.cards })))} />
</section>

<style>
  .hero{padding:calc(4.5rem + clamp(3rem,7vw,6rem)) 0 clamp(3rem,6vw,5rem);background:var(--white);position:relative}
  /* subtle texture: faint concentric rings radiating from behind the photo panel, faded out toward the edges */
  .hero::before{content:'';position:absolute;inset:0 0 -12rem 0;z-index:0;pointer-events:none;
    background-image:repeating-radial-gradient(circle at 72% 52%,transparent 0 9px,rgba(14,13,11,.085) 9px 10px);
    -webkit-mask-image:radial-gradient(75% 90% at 72% 45%,#000 25%,transparent 100%),linear-gradient(180deg,#000 55%,transparent 95%);mask-image:radial-gradient(75% 90% at 72% 45%,#000 25%,transparent 100%),linear-gradient(180deg,#000 55%,transparent 95%);-webkit-mask-composite:source-in;mask-composite:intersect}
  .hero>.wrap{position:relative;z-index:1}
  @media (max-width:960px){.hero::before{background-image:repeating-radial-gradient(circle at 50% 70%,transparent 0 9px,rgba(14,13,11,.085) 9px 10px);-webkit-mask-image:radial-gradient(90% 60% at 50% 60%,#000 30%,transparent 100%),linear-gradient(180deg,#000 55%,transparent 95%);mask-image:radial-gradient(90% 60% at 50% 60%,#000 30%,transparent 100%),linear-gradient(180deg,#000 55%,transparent 95%)}}
  .hero__in{display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(2rem,5vw,5rem);align-items:center}
  .hero__copy{display:grid;gap:1.5rem;align-content:center}
  .hero__copy .display{font-size:clamp(3.1rem,5.4vw,4.8rem)}
  .hero__copy .lead{max-width:34rem}
  .hero__media{position:relative;padding:1.5rem 0 2.5rem;justify-self:center;width:min(100%,32rem)}
  .hero__circle{cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none;position:relative;width:100%;aspect-ratio:1;border-radius:var(--r-xl);overflow:hidden;background:var(--paper-2);isolation:isolate}
  .hero__circle.is-dragging{cursor:grabbing}
  .hero__circle.is-dragging .hero__photo.is-on{transition:transform .05s linear}
  .hero__frame{position:relative}
  /* the button is the tap target; ::after draws the small mark, so spacing never shrinks the hit area */
  .hero__dots{display:flex;justify-content:center;align-items:center;gap:.4rem;margin-top:.8rem}
  .hero__dot{height:1.25rem;padding:0 .3rem;display:grid;place-items:center;background:none;-webkit-tap-highlight-color:transparent}
  .hero__dot::after{content:'';display:block;width:.4rem;height:.4rem;border-radius:99px;background:var(--ink-12);transition:width .4s var(--ease),background-color .35s var(--ease)}
  .hero__dot:hover::after{background-color:var(--ink-40)}
  /* the active dot becomes a track; the gradient is the fill, grown by background-size */
  .hero__dot.is-on::after{width:1.6rem;background-color:var(--ink-12);background-image:linear-gradient(var(--ink),var(--ink));background-repeat:no-repeat;background-size:0% 100%}
  .hero__dot.is-on.is-running::after{background-size:100% 100%;transition:width .4s var(--ease),background-size var(--scene) linear}
  .hero__dot:focus-visible{outline:2px solid var(--ink);outline-offset:1px;border-radius:.4rem}
  @media (prefers-reduced-motion: reduce){ .hero__dot.is-on::after{background-size:100% 100%} .hero__dot.is-on.is-running::after{transition:none} }
  .hero__photo{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;opacity:0;transform:scale(1.06);transition:opacity .9s var(--ease),transform 7s linear}
  .hero__photo.is-on{opacity:1;transform:scale(1)}
  .hero__chat{position:absolute;left:8%;right:8%;top:22%;display:grid;gap:.6rem;justify-items:start;z-index:2}
  .hero__tabs{display:inline-flex;padding:.2rem;border-radius:var(--r-pill);background:rgba(14,13,11,.55);backdrop-filter:blur(8px);font-size:.72rem;color:rgba(255,255,255,.7)}
  .hero__tabs span{padding:.3rem .8rem;border-radius:var(--r-pill)}
  .hero__tabs span.is-on{background:var(--white);color:var(--ink);font-weight:500}
  .hero__bubble{display:flex;gap:.6rem;align-items:flex-start;max-width:100%;opacity:0;transform:translateY(8px);transition:opacity .45s var(--ease),transform .5s var(--ease)}
  .hero__bubble.is-on{opacity:1;transform:none}
  .hero__av{flex:none;width:2.2rem;height:2.2rem;border-radius:50%;border:2px solid var(--white);background:var(--lime);display:grid;place-items:center;font-size:.6rem;font-weight:700;color:var(--ink)}
  .hero__msg{font-family:var(--serif);font-weight:300;font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.2;color:var(--ink);background:rgba(255,255,255,.9);backdrop-filter:blur(10px);padding:.55rem .9rem;border-radius:1rem 1rem 1rem .25rem;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  .hero__typing{display:flex;gap:.3rem;align-items:center;height:2rem;padding:0 .8rem;border-radius:var(--r-pill);background:var(--ink);opacity:0;transition:opacity .3s;margin-left:2.8rem}
  .hero__typing.is-on{opacity:1}
  .hero__typing i{width:.4rem;height:.4rem;border-radius:50%;background:var(--lime);animation:ty 1s infinite}
  .hero__typing i:nth-child(2){animation-delay:.15s}.hero__typing i:nth-child(3){animation-delay:.3s}
  @keyframes ty{0%,60%,100%{opacity:.35;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
  .hero__reply{display:flex;gap:.5rem;align-items:flex-start;max-width:88%;margin-left:2.8rem;background:var(--ink);color:var(--on-dark);padding:.6rem .85rem;border-radius:1rem 1rem 1rem .25rem;font-size:.86rem;line-height:1.35;opacity:0;transform:translateY(8px);transition:opacity .45s var(--ease),transform .5s var(--ease)}
  .hero__reply.is-on{opacity:1;transform:none}
  .hero__reply .dot{margin-top:.3rem}
  .hero__cards{position:absolute;inset:0;pointer-events:none}
  .hero__card{position:absolute;width:10.5rem;background:var(--white);border-radius:var(--r-lg);box-shadow:var(--shadow-lg);padding:.9rem 1rem;display:grid;gap:.15rem;opacity:0;transform:translateY(14px) scale(.96);transition:opacity .5s var(--ease),transform .6s var(--ease)}
  .hero__card.is-on{opacity:1;transform:none}
  .hero__card--a{background:var(--viv-green);color:var(--white)}
  .hero__card--a .hero__card-k,.hero__card--a .hero__card-s{color:rgba(255,255,255,.7)}
  .hero__card--b{transition-delay:.15s}
  /* four layouts so the cards land somewhere different each scenario */
  [data-cards-layout="0"] .hero__card--a{right:-1rem;top:6%}[data-cards-layout="0"] .hero__card--b{left:-1rem;bottom:8%}
  [data-cards-layout="1"] .hero__card--a{left:-1.2rem;top:10%}[data-cards-layout="1"] .hero__card--b{right:-1rem;bottom:14%}
  [data-cards-layout="2"] .hero__card--a{right:6%;bottom:-1rem}[data-cards-layout="2"] .hero__card--b{left:-1rem;top:16%}
  [data-cards-layout="3"] .hero__card--a{left:4%;bottom:-.5rem}[data-cards-layout="3"] .hero__card--b{right:-1.2rem;top:4%}
  .hero__card-k{display:flex;justify-content:space-between;align-items:center;font-size:.78rem;font-weight:500;color:var(--ink-60)}
  .hero__card-d{font-size:.68rem;padding:.1rem .45rem;border-radius:var(--r-pill);background:var(--lime);color:var(--ink);font-weight:600}
  .hero__card-d:empty{display:none}
  .hero__card-v{font-size:2.4rem;font-weight:500;letter-spacing:-.04em;line-height:1.05}
  .hero__card-v :global(small){font-size:1.1rem;color:inherit;opacity:.55;letter-spacing:0}
  .hero__card-s{font-size:.74rem;color:var(--ink-40)}
  @media (max-width:960px){.hero{padding-top:calc(4rem + 2.5rem)}.hero__in{grid-template-columns:1fr;gap:2.5rem}.hero__media{width:min(100%,26rem);padding:1rem 0 2rem}.hero__chat{top:18%}.hero__msg{font-size:1.05rem}.hero__card{width:9rem}.hero__card-v{font-size:1.9rem}[data-cards-layout] .hero__card--a{right:-.25rem;left:auto;top:0;bottom:auto}[data-cards-layout] .hero__card--b{left:-.25rem;right:auto;bottom:0;top:auto}}
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-loop]');
  if (root) {
    const scenes: any[] = JSON.parse(document.getElementById('hero-scenes')!.textContent || '[]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SCENE_MS = parseFloat(getComputedStyle(root.querySelector<HTMLElement>('.hero__dots')!).getPropertyValue('--scene')) || 7600;
    const photos = Array.from(root.querySelectorAll<HTMLImageElement>('[data-scene-photo]'));
    const bubble = root.querySelector<HTMLElement>('[data-bubble]')!, av = root.querySelector<HTMLElement>('[data-av]')!, msg = root.querySelector<HTMLElement>('[data-msg]')!;
    const typing = root.querySelector<HTMLElement>('[data-typing]')!, reply = root.querySelector<HTMLElement>('[data-reply]')!, replyText = root.querySelector<HTMLElement>('[data-reply-text]')!;
    const outs = Array.from(root.querySelectorAll<HTMLElement>('[data-out]'));
    let i = 0, timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, reduce ? 0 : ms));
    const play = (n: number) => {
      timers.forEach(clearTimeout); timers = []; i = n;
      const s = scenes[n];
      photos.forEach((p, j) => { p.classList.toggle('is-on', j === n); p.style.transform = ''; });
      const allDots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
      allDots.forEach((d, j) => { const on = j === n; d.classList.toggle('is-on', on); d.classList.remove('is-running'); d.setAttribute('aria-selected', String(on)); });
      const active = allDots[n];
      if (active && !reduce) { void active.offsetWidth; requestAnimationFrame(() => active.classList.add('is-running')); }
      [bubble, typing, reply, ...outs].forEach(e => e.classList.remove('is-on'));
      later(() => { av.textContent = s.who.split(' ')[0].slice(0, 2).toUpperCase(); msg.textContent = s.msg; bubble.classList.add('is-on'); }, 500);
      later(() => typing.classList.add('is-on'), 1500);
      later(() => { typing.classList.remove('is-on'); replyText.textContent = s.reply; reply.classList.add('is-on'); }, 2900);
      later(() => { root.querySelector<HTMLElement>('[data-cards-layout]')!.dataset.cardsLayout = String(n); }, 450);
      later(() => outs.forEach((o, j) => { const c = s.cards[j]; o.querySelector('[data-out-k]')!.textContent = c.k; o.querySelector('[data-out-d]')!.textContent = c.d; o.querySelector('[data-out-v]')!.innerHTML = c.v; o.querySelector('[data-out-s]')!.textContent = c.s; o.classList.add('is-on'); }), 3600);
      later(() => play((n + 1) % scenes.length), reduce ? 8000 : SCENE_MS);
    };
    // Drag or swipe the photo to move between scenarios; dots mirror and jump.
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const mark = (n: number) => dots.forEach((d, j) => { const on = j === n; d.classList.toggle('is-on', on); d.setAttribute('aria-selected', String(on)); });
    const go = (n: number) => { const t = (n + scenes.length) % scenes.length; mark(t); play(t); };
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    const stage = root.querySelector<HTMLElement>('[data-hero-drag]');
    if (stage && !reduce) {
      let x0 = 0, dx = 0, dragging = false, id = -1;
      const on = photos[0];
      const shift = (px: number) => { const cur = photos[i]; if (cur) cur.style.transform = `scale(1) translateX(${px}px)`; };
      const reset = () => { const cur = photos[i]; if (cur) cur.style.transform = ''; };
      stage.addEventListener('pointerdown', (e) => { dragging = true; id = e.pointerId; x0 = e.clientX; dx = 0; stage.classList.add('is-dragging'); stage.setPointerCapture(id); });
      stage.addEventListener('pointermove', (e) => { if (!dragging) return; dx = e.clientX - x0; shift(dx * 0.35); });
      const finish = () => {
        if (!dragging) return; dragging = false; stage.classList.remove('is-dragging');
        const moved = dx; reset();
        if (Math.abs(moved) > 45) go(i + (moved < 0 ? 1 : -1)); else play(i);
      };
      stage.addEventListener('pointerup', finish);
      stage.addEventListener('pointercancel', finish);
      stage.addEventListener('dragstart', (e) => e.preventDefault());
      void on;
    }
    if (reduce) { const s = scenes[0]; photos[0].classList.add('is-on'); av.textContent = 'AV'; msg.textContent = s.msg; bubble.classList.add('is-on'); replyText.textContent = s.reply; reply.classList.add('is-on'); outs.forEach((o, j) => { const c = s.cards[j]; o.querySelector('[data-out-k]')!.textContent = c.k; o.querySelector('[data-out-v]')!.innerHTML = c.v; o.querySelector('[data-out-s]')!.textContent = c.s; o.classList.add('is-on'); }); }
    else { new IntersectionObserver(([e]) => { if (e.isIntersecting) play(i); else { timers.forEach(clearTimeout); timers = []; } }, { threshold: 0.2 }).observe(root); }
  }
</script>
