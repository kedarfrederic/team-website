<script>
  const app = document.querySelector<HTMLElement>('[data-rh]');
  if (app) {
    const tabs = Array.from(app.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(app.querySelectorAll<HTMLElement>('[data-panel]'));
    const crumb = app.querySelector<HTMLElement>('[data-rh-crumb]');
    let idx = 0, timer: number | undefined, paused = false;
    const CYCLE = 4200;
    const show = (i: number) => {
      idx = i;
      tabs.forEach((t, j) => { t.classList.toggle('is-on', j === i); t.setAttribute('aria-pressed', String(j === i)); const bar = t.querySelector('i')!; bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; });
      panels.forEach((p, j) => p.classList.toggle('is-on', j === i));
      if (crumb) crumb.textContent = tabs[i].textContent!.replace(/\d+\/?\d*$/, '').trim();
    };
    const tick = () => { if (!paused) show((idx + 1) % tabs.length); };
    const start = () => { stop(); timer = window.setInterval(tick, CYCLE); };
    const stop = () => { if (timer) window.clearInterval(timer); };
    tabs.forEach((t, i) => t.addEventListener('click', () => { show(i); start(); }));
    app.addEventListener('mouseenter', () => (paused = true));
    app.addEventListener('mouseleave', () => (paused = false));
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.3 }).observe(app);
    // fixed design size, uniform scale to fit the container; native layout on small screens
    const stage = document.querySelector<HTMLElement>('[data-rh-stage]')!;
    const fit = () => {
      const w = stage.clientWidth;
      if (w < 640) { app.classList.add('is-mobile'); app.style.transform = ''; stage.style.height = ''; return; }
      app.classList.remove('is-mobile');
      const k = Math.min(1.3, w / 1120); app.style.transform = `scale(${k})`; stage.style.height = app.offsetHeight * k + 'px';
    };
    fit(); window.addEventListener('resize', fit); new ResizeObserver(fit).observe(app);
  }
</script>
