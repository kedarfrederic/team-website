---
// Three proof points in one panel. Each carries a small dotted-ring badge that echoes the orbit illustration further down.
const stats = [
  { n: '300', suf: '+', l: 'releases managed on Team so far', s: 'Since early access opened', c: 'var(--lime)', core: 'var(--viv-green)', p: 100, glyph: 'M4 7h16M4 12h10M4 17h13' },
  { n: '6.5', suf: ' hrs', l: 'given back per release week, on average', s: 'Reported by beta users', c: 'var(--viv-cyan)', core: 'var(--viv-green)', p: 62, glyph: 'M12 7v5l3 2' },
  { n: '0', from: '100', suf: '%', l: 'of customer data used to train any model', s: "Not ours, not anyone else's", c: 'var(--viv-pink)', core: 'var(--viv-orange)', p: 0, glyph: 'M12 4l6 3v5c0 4-3 6.5-6 8-3-1.5-6-4-6-8V7z' },
];
const R = 26, C = 2 * Math.PI * R;
---
<section class="sb">
  <div class="wrap">
    <ul class="sb__row" data-reveal-stagger="0.12">
      {stats.map((x) => (
        <li class="sb__item">
          <span class="sb__badge" style={`--c:${x.c};--core:${x.core}`}>
            <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
              <circle class="sb__ring" cx="32" cy="32" r="30" fill="none" style="stroke:var(--ink-12)" stroke-width="1.5" stroke-dasharray="1.5 5" stroke-linecap="round" />
              <circle cx="32" cy="32" r={R} fill="none" style="stroke:var(--ink-6)" stroke-width="3" />
              <circle class="sb__arc" cx="32" cy="32" r={R} fill="none" style={`stroke:var(--c)`} stroke-width="3" stroke-linecap="round" stroke-dasharray={C} stroke-dashoffset={C * (1 - x.p / 100)} transform="rotate(-90 32 32)" />
              <circle cx="32" cy="32" r="16" style="fill:var(--core)" />
              <path d={x.glyph} fill="none" style="stroke:var(--white)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(20 20) scale(1)" />
            </svg>
          </span>
          <p class="sb__n"><em data-count={x.n} data-from={x.from} data-suffix={x.suf}>{x.from ?? 0}</em></p>
          <p class="sb__l">{x.l}</p>
          <p class="sb__s"><span class="sb__dot" style={`--c:${x.c}`}></span>{x.s}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sb{background:var(--white);padding:0 0 var(--section)}
  .sb__row{display:grid;grid-template-columns:repeat(3,1fr);background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);overflow:hidden}
    /* rows: badge, number, label (takes the slack), footnote — so the footnote sits on the
     same line in every tile however long the label runs */
  .sb__item{position:relative;display:grid;grid-template-rows:auto auto 1fr auto;gap:.35rem;padding:2rem 2rem 1.75rem}
  .sb__item+.sb__item::before{content:'';position:absolute;left:0;top:1.5rem;bottom:1.5rem;border-left:1.5px dashed var(--ink-12)}
  .sb__badge{display:block;width:4rem;height:4rem;margin-bottom:1.1rem}
  .sb__ring{transform-box:fill-box;transform-origin:center;animation:spin 60s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  .sb__n{font-size:clamp(2.6rem,4.5vw,4rem);line-height:1;letter-spacing:-.03em}
  .sb__n em{font-family:var(--serif);font-weight:300;font-style:normal;font-variant-numeric:tabular-nums}
  .sb__l{margin-top:.5rem;color:var(--ink);font-weight:500;line-height:1.35;max-width:18rem}
  .sb__s{display:flex;align-items:center;gap:.45rem;font-size:.82rem;color:var(--ink-40)}
  .sb__dot{width:.5rem;height:.5rem;border-radius:50%;background:var(--c)}
  @media (max-width:800px){.sb__row{grid-template-columns:1fr}.sb__item+.sb__item::before{left:1.5rem;right:1.5rem;top:0;bottom:auto;border-left:0;border-top:1.5px dashed var(--ink-12)}}
  @media (prefers-reduced-motion:reduce){.sb__ring{animation:none}}
</style>
