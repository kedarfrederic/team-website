---
import { plans, planLink, freeLink } from '../../data/plans';
---
<section class="pl section section--paper" id="pricing">
  <div class="wrap">
    <div class="head head--center">
      <h2 class="h1 lines"><span class="line"><span>Start free.</span></span><span class="line"><span>Add seats as you <em>grow.</em></span></span></h2>
      <p class="lead" data-reveal style="margin-inline:auto">Free for one person and one artist. Pro and Ultra are priced per seat, and the people you share with never need one. Every new account starts with 14 days of Ultra.</p>
    </div>
    <div class="pl__grid" data-reveal-stagger="0.12">
      <article class="pl__card">
        <p class="pl__k">Free</p>
        <p class="pl__price"><b>$0</b><span>forever</span></p>
        <p class="pl__d">For one person getting a release out. 1 seat, 1 artist.</p>
        <ul class="pl__list"><li>Releases, rollout plan, files and budget</li><li>Day to day and the iPhone app</li><li>TeamMate, 10 messages a day</li><li>Unlimited drop links</li></ul>
        <a class="btn btn--lime btn--lg" href={freeLink}>Start free <span class="arr">→</span></a>
        <p class="cta-note">No card required.</p>
      </article>
      <article class="pl__card">
        <p class="pl__k">Pro</p>
        <p class="pl__price"><b>${plans.pro.yearly}</b><span>per seat a month, billed yearly</span></p>
        <p class="pl__d">For a small team running a few artists. Up to 5 artists.</p>
        <ul class="pl__list"><li>Everything in Free</li><li>All of TeamMate, by email and text too</li><li>Team Chat, reports and sharing</li><li>Connectors to the tools you use</li></ul>
        <a class="btn btn--primary btn--lg" href={planLink('pro')}>Choose Pro <span class="arr">→</span></a>
        <p class="cta-note">Or ${plans.pro.monthly} billed monthly.</p>
      </article>
      <article class="pl__card pl__card--pro">
        <p class="pl__k">Ultra <span class="tag tag--lime">14 days free</span></p>
        <p class="pl__price"><b>${plans.ultra.yearly}</b><span>per seat a month, billed yearly</span></p>
        <p class="pl__d">For a management company or label, on the road too. From 1 seat to 20, unlimited artists.</p>
        <ul class="pl__list"><li>Everything in Pro</li><li>Touring</li><li>The A&R pipeline</li><li>One view across every artist</li></ul>
        <a class="btn btn--lime btn--lg" href={planLink('ultra')}>Choose Ultra <span class="arr">→</span></a>
        <p class="cta-note">Or ${plans.ultra.monthly} billed monthly.</p>
      </article>
    </div>
    <p class="pl__more" data-reveal>More than 20 seats? <a class="link" href="/enterprise">See Enterprise <span class="arr">→</span></a> <span class="pl__sep" aria-hidden="true">·</span> <a class="link" href="/pricing">Compare every plan <span class="arr">→</span></a></p>
  </div>
</section>
<style>
  .pl__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;max-width:72rem;margin-inline:auto}
  .pl__card{background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);padding:2rem;display:grid;grid-template-rows:auto auto auto 1fr auto auto;gap:1rem;min-width:0}
  .pl__card--pro{background:var(--ink);color:var(--on-dark);border-color:transparent}
  .pl__k{font-weight:500;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;min-height:1.7rem}
  .pl__price{display:flex;align-items:baseline;gap:.5rem;flex-wrap:wrap}
  .pl__price b{font-size:3rem;font-weight:500;letter-spacing:-.04em;line-height:1}
  .pl__price span{color:var(--ink-40);font-size:.9rem;max-width:10rem;line-height:1.3}
  .pl__card--pro .pl__price span,.pl__card--pro .pl__d,.pl__card--pro .cta-note{color:var(--on-dark-60)}
  .pl__d{color:var(--ink-60);line-height:1.5}
  .pl__list{display:grid;gap:.45rem;margin:.5rem 0 .75rem;align-content:start}
  .pl__list li{position:relative;padding-left:1.4rem;font-size:.95rem}
  .pl__list li::before{content:'✓';position:absolute;left:0;top:.35em;width:.9rem;height:.9rem;border-radius:50%;background:var(--lime);color:var(--ink);font-size:.55rem;display:grid;place-items:center}
  .pl__card .btn{justify-self:start}
  .pl__card .cta-note{margin-top:0}
  .pl__more{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.5rem .75rem;text-align:center;margin-top:2rem;color:var(--ink-60)}
  .pl__sep{color:var(--ink-40)}
  @media (max-width:980px){.pl__grid{grid-template-columns:minmax(0,1fr);max-width:32rem}}
</style>
