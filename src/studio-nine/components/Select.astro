---
/**
 * Brand dropdown.
 *
 * A real <select> stays in the form (so it posts, validates and works without JS); the visible
 * control is ours. Keyboard and screen-reader behaviour follow the listbox pattern, and if the
 * script never runs the native control is shown instead, so the form is never unusable.
 */
interface Props { name: string; options: string[]; placeholder?: string; required?: boolean; }
const { name, options, placeholder = 'Choose one', required = false } = Astro.props;
const id = `sel-${name}-${Math.random().toString(36).slice(2, 7)}`;
---
<div class="sel" data-select>
  <select class="sel__native" name={name} required={required} id={id}>
    <option value="">{placeholder}</option>
    {options.map((o) => <option value={o}>{o}</option>)}
  </select>

  <button class="sel__btn" type="button" role="combobox" aria-expanded="false" aria-controls={`${id}-list`} aria-haspopup="listbox" aria-labelledby={id} hidden>
    <span class="sel__val" data-sel-value>{placeholder}</span>
    <svg class="sel__chev" viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
  </button>

  <ul class="sel__list" id={`${id}-list`} role="listbox" hidden>
    {options.map((o) => <li class="sel__opt" role="option" aria-selected="false" data-value={o}><span>{o}</span><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg></li>)}
  </ul>
</div>

<style>
  .sel{position:relative}
  /* the native control is the fallback; the script hides it once ours is wired up */
  .sel__native{width:100%}
  .sel.is-ready .sel__native{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
  .sel__btn{display:flex;align-items:center;justify-content:space-between;gap:.75rem;width:100%;font:inherit;font-size:1rem;color:var(--ink);text-align:left;padding:.75rem .9rem;border:1px solid var(--ink-12);border-radius:var(--r-btn);background:var(--white);transition:border-color .2s var(--ease),box-shadow .2s var(--ease)}
  .sel__btn:hover{border-color:var(--ink-40)}
  .sel__btn[aria-expanded='true'],.sel__btn:focus-visible{outline:none;border-color:var(--ink);box-shadow:0 0 0 3px var(--lime-wash)}
  .sel__val{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .sel:not(.has-value) .sel__val{color:var(--ink-40)}
  .sel__chev{flex:none;color:var(--ink-40);transition:transform .25s var(--ease)}
  .sel__btn[aria-expanded='true'] .sel__chev{transform:rotate(180deg);color:var(--ink)}
  .sel__list{position:absolute;z-index:20;top:calc(100% + .35rem);left:0;right:0;max-height:15rem;overflow-y:auto;padding:.3rem;border-radius:var(--r-btn);background:var(--white);box-shadow:var(--shadow-lg),0 0 0 1px var(--ink-12);animation:sel-in .18s var(--ease)}
  @keyframes sel-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
  .sel__opt{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:.6rem .7rem;border-radius:calc(var(--r-btn) - .25rem);font-size:.95rem;cursor:pointer}
  .sel__opt svg{opacity:0;flex:none;color:var(--green-ink)}
  .sel__opt[aria-selected='true'] svg{opacity:1}
  .sel__opt.is-active,.sel__opt:hover{background:var(--paper)}
  .sel__opt[aria-selected='true']{font-weight:500}
  @media (prefers-reduced-motion:reduce){.sel__list{animation:none}.sel__chev{transition:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-select]').forEach((root) => {
    const native = root.querySelector<HTMLSelectElement>('.sel__native')!;
    const btn = root.querySelector<HTMLButtonElement>('.sel__btn')!;
    const list = root.querySelector<HTMLUListElement>('.sel__list')!;
    const valueEl = root.querySelector<HTMLElement>('[data-sel-value]')!;
    const opts = Array.from(root.querySelectorAll<HTMLLIElement>('.sel__opt'));
    let active = -1;

    // Only take over once the script runs, so no-JS keeps the native control.
    root.classList.add('is-ready');
    btn.hidden = false;

    const setActive = (i: number) => {
      active = Math.max(0, Math.min(opts.length - 1, i));
      opts.forEach((o, n) => o.classList.toggle('is-active', n === active));
      opts[active]?.scrollIntoView({ block: 'nearest' });
    };
    const open = () => {
      list.hidden = false; btn.setAttribute('aria-expanded', 'true');
      setActive(Math.max(0, opts.findIndex((o) => o.dataset.value === native.value)));
    };
    const close = () => { list.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
    const choose = (i: number) => {
      const o = opts[i]; if (!o) return;
      native.value = o.dataset.value || '';
      native.dispatchEvent(new Event('change', { bubbles: true }));
      valueEl.textContent = o.querySelector('span')?.textContent || '';
      root.classList.add('has-value');
      opts.forEach((x, n) => x.setAttribute('aria-selected', String(n === i)));
      close(); btn.focus();
    };

    btn.addEventListener('click', () => (list.hidden ? open() : close()));
    opts.forEach((o, i) => o.addEventListener('click', () => choose(i)));

    btn.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
        e.preventDefault();
        if (list.hidden) { open(); return; }
        if (e.key === 'Enter' || e.key === ' ') choose(active);
        else setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
      } else if (e.key === 'Escape') { close(); }
      else if (/^[a-z0-9]$/i.test(e.key)) {
        const i = opts.findIndex((o) => (o.querySelector('span')?.textContent || '').toLowerCase().startsWith(e.key.toLowerCase()));
        if (i >= 0) { if (list.hidden) open(); setActive(i); }
      }
    });

    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) close(); });
    // Keep the visible label honest if anything resets the form.
    native.form?.addEventListener('reset', () => {
      setTimeout(() => { valueEl.textContent = native.options[0].textContent; root.classList.remove('has-value'); opts.forEach((o) => o.setAttribute('aria-selected', 'false')); }, 0);
    });
  });
</script>
