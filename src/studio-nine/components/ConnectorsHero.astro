---
// Connectors hero. One coordinate space: the tile is exactly 400x390 units, the SVG covers all of it, and every element is placed in those units so lines always meet.
const tools = [
  ['dropbox','var(--viv-pink)'],['slack','var(--lime)'],['googlesheets','var(--viv-lav)'],['gmail','var(--paper-2)'],['notion-dark','var(--viv-cyan)'],['googlecalendar','var(--viv-orange)'],['googledrive','var(--viv-lav)'],['airtable','var(--lime)'],
];
const feed = [
  ['Dropbox','New master landed · v10','Updated the one-sheet to v10','Docs'],
  ['Sheets','Content budget $2,500 → $3,100','Re-briefed the distributor','Gmail'],
  ['Slack','Maya approved the artwork','Attached to the pitch task','Timeline'],
  ['Calendar','Video shoot moved to Thu','Re-cut 4 dependent tasks','Timeline'],
  ['Notion','Rollout plan edited','Synced 11 tasks both ways','Rollouts'],
];
const W = 400, H = 390, N = tools.length, CX = 200;
const CORE = { x: CX, y: 236, r: 26 }; const T = 16; // tile half-size
// Equal horizontal spacing on a shallow arc, so the gaps read even and the highlight ring never touches a neighbour.
const pos = (i: number) => { const t = i / (N - 1); const x = 42 + t * (W - 84); const y = 118 - Math.sin(t * Math.PI) * 62; return { x, y }; };
const curve = (i: number) => { const p = pos(i); const ax = p.x, ay = p.y + T; const bx = CORE.x + Math.max(-14, Math.min(14, (p.x - CX) * .12)), by = CORE.y - CORE.r; const my = ay + (by - ay) * .55; return `M${ax} ${ay} C${ax} ${my} ${bx} ${my} ${bx} ${by}`; };
---
<div class="ch" data-ch>
  <svg class="ch__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    <defs><filter id="chg" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5"/></filter></defs>
    {tools.map((_, i) => <path d={curve(i)} fill="none" style="stroke:var(--ink-12)" stroke-width="1.5" stroke-dasharray="1.5 6" stroke-linecap="round" />)}
    {tools.map((_, i) => { const p = pos(i); return (
      <g data-ch-spoke={i}>
        <path d={curve(i)} fill="none" stroke="none" data-ch-path />
        <path d={curve(i)} fill="none" style="stroke:var(--ink)" stroke-width="1.6" stroke-linecap="round" opacity="0" data-ch-trace />
        <circle r="8" cx={p.x} cy={p.y} style={`fill:${tools[i][1]}`} opacity="0" filter="url(#chg)" data-ch-glow />
        <circle r="4" cx={p.x} cy={p.y} style="fill:var(--ink)" opacity="0" data-ch-pkt />
      </g>
    ); })}
  </svg>
  {tools.map(([t, c], i) => { const p = pos(i); return (
    <span class="ch__tool" data-ch-tool={i} style={`--x:${(p.x / W * 100).toFixed(2)}%;--y:${(p.y / H * 100).toFixed(2)}%;--bg:${c}`}><img src={`/studio-nine/logos/${t}.svg`} alt="" loading="lazy" /></span>
  ); })}
  <div class="ch__core" style={`--x:${(CORE.x / W * 100).toFixed(2)}%;--y:${(CORE.y / H * 100).toFixed(2)}%`}><img src="/studio-nine/logo/team-logomark-white.png" alt="Team" /></div>
  <ol class="ch__feed" data-ch-feed>
    {feed.map(([src, ev, act, dst], i) => (
      <li class:list={['ch__line', { 'is-on': i === 0 }]} data-ch-line={i}>
        <span class="ch__k"><b>{src}</b>{ev}</span>
        <span class="ch__a"><i>✓</i>{act}<em>{dst}</em></span>
      </li>
    ))}
  </ol>
</div>

<style>
  .ch{position:relative;width:100%;max-width:30rem;aspect-ratio:400/390;background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--shadow-lg);
    background-image:repeating-radial-gradient(circle at 50% 59%,transparent 0 11px,var(--ink-6) 11px 12px);container-type:inline-size}
  .ch__svg{position:absolute;inset:0;width:100%;height:100%}
  /* tiles and core sized in container units so they match the SVG's 400-unit width at any size */
  .ch__tool{z-index:1;position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:8cqw;height:8cqw;border-radius:2.3cqw;background:var(--bg);display:grid;place-items:center;box-shadow:var(--shadow-md);transition:transform .35s var(--ease),box-shadow .35s}
  .ch__tool img{width:4.1cqw;height:4.1cqw;max-width:none}
  .ch__tool.is-live{transform:translate(-50%,-50%) scale(1.12);box-shadow:0 0 0 3px var(--white),0 0 0 5px var(--bg),var(--shadow-lg)}
  .ch__core{z-index:1;position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:13cqw;height:13cqw;border-radius:4cqw;background:var(--ink);display:grid;place-items:center;box-shadow:var(--shadow-lg)}
  .ch__core::after{content:'';position:absolute;inset:-1.4cqw;border-radius:5.2cqw;border:2px solid var(--lime);animation:chp 2.4s ease-out infinite}
  @keyframes chp{0%{transform:scale(1);opacity:.9}100%{transform:scale(1.35);opacity:0}}
  .ch__core img{width:7cqw;max-width:none}
  .ch__feed{position:absolute;left:4%;right:4%;bottom:4%;height:19%}
  .ch__line{position:absolute;inset:0;display:grid;align-content:center;gap:.3rem;padding:.6rem .85rem;border-radius:.8rem;background:var(--ink);color:var(--on-dark);font-size:.8rem;line-height:1.3;opacity:0;transform:translateY(8px);transition:opacity .4s var(--ease),transform .5s var(--ease)}
  .ch__line.is-on{opacity:1;transform:none}
  .ch__k{display:flex;gap:.5rem;align-items:baseline;color:var(--on-dark-60)}.ch__k b{color:var(--white);font-weight:500}
  .ch__a{display:flex;gap:.45rem;align-items:center;color:var(--white)}
  .ch__a i{width:1.05rem;height:1.05rem;border-radius:50%;background:var(--lime);color:var(--ink);font-style:normal;font-size:.6rem;font-weight:700;display:grid;place-items:center}
  .ch__a em{font-style:normal;margin-left:auto;font-size:.7rem;padding:.12rem .45rem;border-radius:99px;background:rgba(255,255,255,.14);color:var(--on-dark-60)}
  @media (max-width:640px){.ch__line{font-size:.72rem}}
  @media (prefers-reduced-motion:reduce){.ch__core::after{animation:none}}
</style>

<script>
  import { gsap, reduce } from '../scripts/motion';
  const root = document.querySelector<HTMLElement>('[data-ch]');
  if (root && !reduce) {
    const spokes = Array.from(root.querySelectorAll<SVGGElement>('[data-ch-spoke]'));
    const tools = Array.from(root.querySelectorAll<HTMLElement>('[data-ch-tool]'));
    const lines = Array.from(root.querySelectorAll<HTMLElement>('[data-ch-line]'));
    const order = [0, 2, 1, 5, 4, 3, 6, 7]; let n = 0;
    const fire = () => {
      const i = order[n % order.length]; const li = n % lines.length; n++;
      const g = spokes[i], path = g.querySelector<SVGPathElement>('[data-ch-path]')!, pkt = g.querySelector('[data-ch-pkt]')!, glow = g.querySelector('[data-ch-glow]')!, trace = g.querySelector<SVGPathElement>('[data-ch-trace]')!;
      const L = path.getTotalLength(); const o = { t: 0 }; trace.style.strokeDasharray = String(L); trace.style.strokeDashoffset = String(L); gsap.set(trace, { opacity: 1 });
      tools[i].classList.add('is-live');
      gsap.timeline({ onComplete: () => tools[i].classList.remove('is-live') })
        .fromTo(o, { t: 0 }, { t: 1, duration: 1.1, ease: 'power2.inOut', onStart: () => gsap.set([pkt, glow], { opacity: 1 }), onUpdate: () => { const p = path.getPointAtLength(o.t * L); gsap.set([pkt, glow], { attr: { cx: p.x, cy: p.y } }); trace.style.strokeDashoffset = String(L * (1 - o.t)); } })
        .to([pkt, glow, trace], { opacity: 0, duration: .35 })
        .add(() => lines.forEach((l, j) => l.classList.toggle('is-on', j === li)), '-=.1')
        .to({}, { duration: .9 });
    };
    let timer: number | undefined;
    new IntersectionObserver(([e]) => { if (e.isIntersecting) { fire(); timer = window.setInterval(fire, 2600); } else if (timer) window.clearInterval(timer); }, { threshold: .3 }).observe(root);
  }
</script>
