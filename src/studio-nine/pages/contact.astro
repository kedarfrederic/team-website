---
import Select from '../components/Select.astro';
import Base from '../layouts/Base.astro';
---
<Base title="Contact Team" description="A question, a walkthrough, or bringing your whole roster onto Team. Tell us what you are after and the right person will get back to you.">
  <section class="ct">
    <div class="wrap ct__in">
      <div class="ct__copy">
        <h1 class="display lines"><span class="line"><span>Let's <em>talk.</em></span></span></h1>
        <p class="lead" data-reveal>A question, a walkthrough, or bringing your whole roster onto Team. Tell us what you are after and the right person will get back to you, usually within a business day.</p>
        <ul class="ct__ways" data-reveal-stagger>
          <li class="tile tile--green"><b>Book a demo</b><span>See a release run on Team, live.</span><a class="ct__link" href="/demo">Grab a slot <span class="arr">→</span></a></li>
          <li class="tile tile--lav"><b>Email</b><span>Prefer to write?</span><a class="ct__link" href="mailto:hello@teamrollouts.com">hello@teamrollouts.com</a></li>
          <li class="tile tile--pink"><b>Already a customer?</b><span>Reach support from inside your workspace. We answer fast.</span></li>
        </ul>
      </div>
      <form class="form" data-form="contact" data-reveal method="post" action="https://admin.getteamnow.com/api/v1/website-leads">
        <input type="hidden" name="source_form" value="contact" /><input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" />
        <div class="form__row"><label>First name<input name="first_name" required autocomplete="given-name" /></label><label>Last name<input name="last_name" required autocomplete="family-name" /></label></div>
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
        <label>Label or company<input name="organization" autocomplete="organization" /></label>
        <label>I'm here about<Select name="role" options={["Artists", "Managers", "Labels", "Distributors and partners", "Enterprise", "Something else"]} placeholder="Choose one" /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button class="btn btn--primary btn--lg" type="submit">Send message <span class="arr">→</span></button>
        <p class="form__msg form__msg--error" data-form-error hidden role="alert"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="10" r="8" /><path d="M10 6v5M10 14v.01" /></svg><span data-form-error-text></span></p>
        <p class="form__done" hidden><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5 8 14.5l8-9" /></svg><span>Thanks. The right person on the team will be in touch shortly.</span></p>
      </form>
    </div>
  </section>
</Base>
<style>
  .ct{padding:calc(4.5rem + clamp(3rem,7vw,6rem)) 0 var(--section)}
  .ct__in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);align-items:start}
  .ct__copy{display:grid;gap:1.5rem}
  .ct__ways{display:grid;gap:.75rem}
  .ct__ways li{gap:.25rem;justify-items:start}
  .ct__ways b{font-weight:500;font-size:1.05rem}.ct__ways span{font-size:.95rem;opacity:.85}
  .ct__link{font-weight:500;border-bottom:1.5px solid currentColor;margin-top:.3rem}
  .form{display:grid;gap:1rem;background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);padding:2rem;box-shadow:var(--shadow-md)}
  .form__row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .form label{display:grid;gap:.4rem;font-size:.88rem;font-weight:500;color:var(--ink-60)}
  .form input:not(.sr-only),.form select,.form textarea{width:100%;min-width:0;font:inherit;font-size:1rem;color:var(--ink);padding:.75rem .9rem;border:1px solid var(--ink-12);border-radius:.7rem;background:var(--white);outline:0;transition:border-color .2s,box-shadow .2s}
  .form input:not(.sr-only):focus,.form select:focus,.form textarea:focus{border-color:var(--ink);box-shadow:0 0 0 3px var(--lime-wash)}
  .form textarea{resize:vertical}
  .form .btn{justify-self:start;margin-top:.5rem}
  /* messages: a panel, not a line of red text */
  .form__msg[hidden],.form__done[hidden]{display:none}
  .form__msg{display:flex;align-items:flex-start;gap:.6rem;padding:.8rem .9rem;border-radius:var(--r-btn);font-size:.92rem;line-height:1.4;font-weight:500}
  .form__msg svg{flex:none;margin-top:.12rem}
  .form__msg--error{background:var(--orange-wash);color:var(--orange-ink);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--viv-orange) 30%,transparent)}
  .form__done{display:flex;align-items:flex-start;gap:.6rem;padding:.9rem 1rem;border-radius:var(--r-btn);background:var(--lime-wash);color:var(--green-ink);font-weight:500;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--lime-2) 60%,transparent)}
  /* a field that failed validation says so, rather than relying on the browser bubble */
  .form label.is-bad input,.form label.is-bad textarea,.form label.is-bad .sel__btn{border-color:var(--viv-orange);box-shadow:0 0 0 3px var(--orange-wash)}
  /* the hint is created by the form script, so it carries no scope attribute of its own */
  :global(.form__hint){display:none;font-size:.8rem;font-weight:500;color:var(--orange-ink)}
  .form label.is-bad :global(.form__hint){display:block}
  @media (max-width:900px){.ct__in{grid-template-columns:1fr}}
  @media (max-width:520px){.form{padding:1.25rem}.form__row{grid-template-columns:1fr}}
</style>
