---
// Paid-social landing page: the release's own tracks complain, Team answers. Plan: docs/lp-tracks.md.
// Characters are clay poses cut from the character sheets, normalised to one body size and baseline
// (public/img/lp/tracks/<char>-<mood>-<n>.webp) so stop-motion pose swaps never jump.
import Base from '../../layouts/Base.astro';
import { pricingFaq } from '../../data/faqs';
import { app, trials } from '../../data/plans';

// Kedar's trial terms (data/plans.ts): Pro is free for 30 days with no card. Same link as the site's own trial buttons.
const trial = app + '?plan=pro';
const img = (p: string) => `/studio-nine/img/lp/tracks/${p}.webp`;
const poses = (id: string, mad: number, glad: number) => [
  ...Array.from({ length: mad }, (_, i) => `mad-${i + 1}`),
  ...Array.from({ length: glad }, (_, i) => `glad-${i + 1}`),
].map((p) => ({ key: p, src: img(`${id}-${p}`) }));

const cast = [
  { id: 'single', dot: '#5b77a6', name: 'Single', wash: '#e2e8f2', mad: 6, glad: 2,
    gripe: 'I live in Dropbox, someone\'s Google Drive and about forty text threads.',
    fix: 'Every file in one library, versioned, with the final one actually marked final.', product: 'Assets' },
  { id: 'focus', dot: '#e9a22a', name: 'Focus Track', wash: '#f8eccb', mad: 4, glad: 3,
    gripe: 'I drop in two weeks. Has anyone told the fans?',
    fix: 'The whole rollout on one timeline, from announce to release day, with an owner on every task.', product: 'Rollouts' },
  { id: 'feature', dot: '#6f7f3a', name: 'Feature', wash: '#e3e8d6', mad: 4, glad: 2,
    gripe: 'Collab agreed. Clearance? Artwork? Delivery? Nobody knows.',
    fix: 'Every sign-off in one checklist. On Pro, TeamMate chases the ones that slip.', product: 'Rollouts + TeamMate' },
  { id: 'remix', dot: '#e0502c', name: 'Remix', wash: '#f6ddd3', mad: 4, glad: 3,
    gripe: 'Four producers, zero credits filed. Who even wrote me?',
    fix: 'Credits, splits and codes live with the track, ready for delivery.', product: 'Rollouts' },
  { id: 'radio', dot: '#9a6fb0', name: 'Radio Edit', wash: '#ebe1ef', mad: 3, glad: 3,
    gripe: 'I don\'t even have a label. Literally.',
    fix: 'Every version sits with its track, labelled and ready to send.', product: 'Assets' },
];

// Hero: the line-up takes turns, Single first. Each speaker gets its gripe, 2-3 stickers about it, and a pose swap per turn.
const turns = [
  { id: 'single', text: 'I\'m in Dropbox, someone\'s Google Drive and forty text threads.' },
  { id: 'focus' },
  { id: 'remix' },
  { id: 'feature' },
  { id: 'radio' },
].map((t) => { const c = cast.find((x) => x.id === t.id)!; return { ...t, name: c.name, dot: c.dot, wash: c.wash, text: t.text ?? c.gripe }; });

// Stickers on the hero bubble, in the site's sticker language (icon tiles + pills, vivid set, tilted).
// Slots keep them on the bubble's edges and padding, never over the text: a tile on the top-right corner,
// a pill hanging off the bottom-left, an optional pill on the top edge.
const ico: Record<string, string> = {
  folder: '<path d="M3.5 7.5a2 2 0 0 1 2-2h3.8l2 2h7.2a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"/>',
  file: '<path d="M7 3.5h6.5L18 8v10.5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2z"/><path d="M13 3.5V8h5"/>',
  chat: '<path d="M5 5h14a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-7.5L7 20v-3.5H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  clock: '<path d="M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17z"/><path d="M12 7.5V12l3 2"/>',
  megaphone: '<path d="M4.5 10v4l9.5 4V6z"/><path d="M17 9.5a3.2 3.2 0 0 1 0 5"/>',
  people: '<path d="M9 4.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/>',
  wave: '<path d="M4 12v2M8 8v8M12 5v14M16 9v6M20 11v2"/>',
  list: '<path d="M10 6.5h10M10 12h10M10 17.5h10"/><path d="m3.5 6.5 1.5 1.5 2.5-3M3.5 12l1.5 1.5 2.5-3"/><path d="M4 17.5h3"/>',
  image: '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="m20.5 15.5-5-5-11 9"/><path d="M8.5 8v.5"/>',
  label: '<path d="M3.5 12.5V5a1.5 1.5 0 0 1 1.5-1.5h7.5L21 12l-8.5 8.5z"/><path d="M8 7.5v1"/>',
};
type Sticker = { c: 'lime' | 'pink' | 'cyan' | 'lav' | 'orange' | 'green'; icon: string; text?: string };
const stickers: Record<string, Sticker[]> = {
  single: [{ c: 'orange', icon: 'folder' }, { c: 'cyan', icon: 'file', text: 'FINAL_final_v3.wav' }, { c: 'pink', icon: 'chat', text: '40 text threads' }],
  focus: [{ c: 'orange', icon: 'calendar' }, { c: 'lime', icon: 'clock', text: 'Drops in 14 days' }, { c: 'pink', icon: 'megaphone', text: '0 posts planned' }],
  remix: [{ c: 'lav', icon: 'people' }, { c: 'orange', icon: 'wave', text: '0 credits filed' }, { c: 'cyan', icon: 'people', text: '4 producers' }],
  feature: [{ c: 'green', icon: 'list' }, { c: 'pink', icon: 'list', text: '0 of 3 signed off' }, { c: 'cyan', icon: 'image', text: 'Artwork missing' }],
  radio: [{ c: 'cyan', icon: 'label' }, { c: 'lav', icon: 'file', text: 'untitled_edit.wav' }],
};
const svg = (k: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${ico[k]}</svg>`;

const reels = [
  { src: 'complaints', title: 'Can I speak to the manager?', len: '1:06' },
  { src: 'single-metadata', title: 'Sort out my metadata', len: '0:30' },
  { src: 'single-prerelease', title: 'Plan my pre-release', len: '0:15' },
  { src: 'single-ep', title: 'Where\'s the rest of my EP?', len: '0:27' },
];

// Each tile takes its character's wash from the cast, so a track keeps one colour down the page.
const wash = (id: string) => cast.find((c) => c.id === id)!.wash;
// Hero line-up: the whole release, still grumpy, with Single in the middle doing the talking.
const lineup = ['focus', 'feature', 'single', 'remix', 'radio'].map((id) => cast.find((c) => c.id === id)!);
const steps = [
  { char: 'focus', pose: 'glad-2', h: 'Put the release in', p: 'Tracks, files, dates, budget and people. Team already knows what a release is, so it is set up in minutes.' },
  { char: 'feature', pose: 'glad-1', h: 'TeamMate does the admin', pro: true, p: 'It keeps the plan current, chases what is missing and asks you only when it needs you.' },
  { char: 'remix', pose: 'glad-1', h: 'Everyone is in step', p: 'Artist, manager, label and partners each see their part of the same release.' },
];

// Closing circle: every track pops up in turn, each happy in a different stance, on its own wash.
const closingPops = [['single', 'glad-1'], ['focus', 'glad-1'], ['feature', 'glad-1'], ['remix', 'glad-1'], ['radio', 'glad-3']]
  .map(([id, pose]) => ({ src: img(`${id}-${pose}`), wash: wash(id) }));

const faq = pricingFaq.filter(([q]) => /trial work|really free|need a card|data mine/.test(q));
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title="Your single has a few complaints" image="/studio-nine/img/og-lp-tracks.jpg" noindex description={`Lost files, missing metadata, no rollout plan. Your release has notes. Put it in Team: try Pro free for ${trials.pro} days with no card, then carry on with Free if you like.`} closing="released" closingPop={closingPops}>

  <!-- 1. Hero: the whole release, each speaker in turn; the ground drifts to the speaker's wash -->
  <section class="lph" style={`--hero-bg:${turns[0].wash};--hero-dot:${turns[0].dot}`}>
    <div class="wrap lph__in">
      <div class="lph__stage" data-reveal data-hero>
        <div class="bubble" aria-live="polite" data-bubble>
          <p class="bubble__msg" data-msg>{turns[0].text}</p>
          {turns.map((t, i) => (
            <div class="bstk" data-stk-set={t.id} hidden={i !== 0} aria-hidden="true">
              {stickers[t.id].map((k, j) => k.text
                ? <span class={`bstk__k bstk__pill bstk--${k.c} bstk__slot-${j === 1 ? 'b' : 't'}`} style={`--k:${j}`}><Fragment set:html={svg(k.icon)} />{k.text}</span>
                : <span class={`bstk__k bstk__tile bstk--${k.c} bstk__slot-c`} style={`--k:${j}`} set:html={svg(k.icon)} />)}
            </div>
          ))}
        </div>
        <div class="lph__line">
          {lineup.map((c, i) => (
            <div class:list={['clay clay--line', { 'is-talking': c.id === turns[0].id }]} data-clay data-cycle="mad" data-hero-clay={c.id} style={`--i:${i}`}>
              <div class="clay__breathe"><div class="clay__boil"><div class="clay__pop">
                {Array.from({ length: c.mad }, (_, j) => `mad-${j + 1}`).map((p, j) => <img src={img(`${c.id}-${p}`)} alt="" data-pose={p} class:list={{ 'is-on': j === 0 }} loading="eager" decoding="async" width="600" height="717" />)}
              </div></div></div>
            </div>
          ))}
        </div>
        <script is:inline type="application/json" data-turns set:html={JSON.stringify(turns)} />
      </div>
      <div class="lph__copy">
        <h1 class="display lines">
          <span class="line"><span>Your single has</span></span>
          <span class="line"><span><em>a few complaints.</em></span></span>
        </h1>
        <p class="lead" data-reveal style="transition-delay:.25s">Lost in five folders. Metadata nowhere. A drop date and no plan. <strong>Put the whole release in Team</strong> and give it nothing to moan about.</p>
        <div class="cta-row" data-reveal style="transition-delay:.35s">
          <a class="btn btn--hero btn--hero-lg" href={trial} data-cta>Start your free trial <span class="tile" set:html={arrow} /></a>
        </div>
        <p class="cta-note" data-reveal style="transition-delay:.45s">Pro free for {trials.pro} days. No card, and Free is yours after that.</p>
      </div>
    </div>
  </section>

  <!-- 2. The cast: before / in Team -->
  <section class="section section--paper cast" data-cast data-state="mad">
    <div class="wrap">
      <div class="cast__head">
        <div class="head">
          <h2 class="h1">The whole release <em>has notes.</em></h2>
          <p class="lead">Every track on the record has been keeping a list. Flip the switch to see the same release in Team.</p>
        </div>
        <div class="seg" role="tablist" aria-label="Show the release before or with Team" data-seg>
          <span class="seg__knob" aria-hidden="true" data-seg-knob></span>
          <button class="seg__opt is-on" type="button" role="tab" aria-selected="true" data-state-btn="mad" style="--c:var(--orange)"><i></i>Before Team</button>
          <button class="seg__opt" type="button" role="tab" aria-selected="false" tabindex="-1" data-state-btn="glad" style="--c:var(--lime-2)"><i></i>With Team</button>
        </div>
      </div>
      <ul class="cast__grid" data-reveal-stagger>
        {cast.map((c) => (
          <li class="ccard" style={`--wash:${c.wash}`} data-ccard>
            <button class="ccard__stage" type="button" aria-label={`Make ${c.name} move`} data-poke>
              <div class="clay" data-clay data-mad={c.mad} data-glad={c.glad}>
                <div class="clay__breathe"><div class="clay__boil"><div class="clay__pop">
                  {poses(c.id, c.mad, c.glad).map((p) => <img src={p.src} alt="" data-pose={p.key} class:list={{ 'is-on': p.key === 'mad-1' }} loading="lazy" decoding="async" width="600" height="717" />)}
                </div></div></div>
              </div>
            </button>
            <div class="ccard__body">
              <p class="ccard__name">{c.name}</p>
              <p class="ccard__say ccard__say--mad">“{c.gripe}”</p>
              <p class="ccard__say ccard__say--glad">{c.fix}</p>
              <span class="tag tag--orange ccard__k ccard__k--mad">Before Team</span>
              <span class="tag tag--lime ccard__k ccard__k--glad">✓ {c.product}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. The reels -->
  <section class="section section--dark reels">
    <div class="wrap">
      <div class="head head--center">
        <h2 class="h1">Hear it from <em>the tracks.</em></h2>
        <p class="lead" style="margin-inline:auto">Four short films from a release that is running out of patience. Sound on.</p>
      </div>
      <ul class="reels__grid" data-reveal-stagger>
        {reels.map((r) => (
          <li class="reel">
            <div class="reel__frame">
              <video src={`/studio-nine/video/lp/${r.src}.mp4`} poster={`/studio-nine/video/lp/${r.src}.jpg`} preload="none" playsinline data-reel></video>
              <button class="reel__play" type="button" aria-label={`Play: ${r.title}`} data-reel-btn><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></button>
            </div>
            <p class="reel__t">{r.title}</p>
            <p class="reel__m tnum">{r.len}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section how">
    <div class="wrap">
      <div class="head head--center">
        <h2 class="h1">Give the release <em>one home.</em></h2>
      </div>
      <ol class="how__grid" data-reveal-stagger>
        {steps.map((s) => (
          <li class="tile how__tile" style={`--bg:${wash(s.char)}`}>
            <div class="how__art">
              <div class="clay clay--sm" data-clay data-cycle={`glad`} data-glad="2">
                <div class="clay__breathe"><div class="clay__boil"><div class="clay__pop">
                  {['glad-1', 'glad-2'].map((p) => <img src={img(`${s.char}-${p}`)} alt="" data-pose={p} class:list={{ 'is-on': p === s.pose }} loading="lazy" decoding="async" width="600" height="717" />)}
                </div></div></div>
              </div>
            </div>
            <h3 class="h3">{s.h}{s.pro && <span class="tag tag--pro how__pro">PRO</span>}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Offer: the hero's old layout, the cast taking turns to say what Team fixed -->
  <section class="section offer">
    <div class="wrap offer__in">
      <div class="offer__copy" data-reveal>
        <h2 class="h1">Give your release<br /><em>nothing to complain about.</em></h2>
        <p class="lead">Try Pro free for {trials.pro} days, no card. <strong>All of TeamMate, Team Chat and Connectors</strong>, so the admin is handled from day one.</p>
        <div class="cta-row">
          <a class="btn btn--hero btn--hero-lg" href={trial} data-cta>Start your free trial <span class="tile" set:html={arrow} /></a>
          <a class="btn btn--ghost btn--lg" href="/pricing">See pricing</a>
        </div>
        <p class="cta-note">No card needed. When the trial ends, choose a plan or carry on with Free.</p>
      </div>
      <div class="offer__stage" data-reveal style={`transition-delay:.15s;--wash:${cast[0].wash}`} data-spot>
        <div class="bubble" aria-live="polite">
          <p class="bubble__who" data-who>{cast[0].name}</p>
          <p class="bubble__msg" data-msg>{cast[0].fix}</p>
        </div>
        <span class="tag tag--lime offer__tag" data-tag>{cast[0].product}</span>
        {cast.map((c, i) => (
          <div class="clay clay--spot" class:list={{ 'is-cur': i === 0 }} data-clay>
            <div class="clay__breathe"><div class="clay__boil"><div class="clay__pop">
              {Array.from({ length: c.glad }, (_, j) => `glad-${j + 1}`).map((p, j) => <img src={img(`${c.id}-${p}`)} alt="" data-pose={p} class:list={{ 'is-on': j === 0 }} loading="lazy" decoding="async" width="600" height="717" />)}
            </div></div></div>
          </div>
        ))}
        <script is:inline type="application/json" data-turns set:html={JSON.stringify(cast.map(({ name, wash, fix, product }) => ({ name, wash, fix, product })))} />
      </div>
    </div>
  </section>

  <!-- 6. FAQ (verbatim from the pricing FAQ) -->
  <section class="section">
    <div class="wrap faq faq--plain">
      <div class="head"><h2 class="h1">FAQs</h2><p class="lead"><a class="link" href="/contact">Or ask us directly <span class="arr">→</span></a></p></div>
      <div class="faq__list">
        {faq.map(([q, a], i) => <details class="faq__i" open={i === 0}><summary><span class="faq__q">{q}</span><span class="faq__x" aria-hidden="true"></span></summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- clay: stop-motion on clean grounds ---------- */
  /* Three stacked transforms so none fight: a stepped breath, an 8fps boil, and a stepped squash on pose swaps. */
  .clay{position:relative;aspect-ratio:600/717;width:100%}
  .clay::after{content:'';position:absolute;left:22%;right:22%;bottom:1.2%;height:4.5%;border-radius:50%;background:radial-gradient(closest-side,rgba(14,13,11,.22),rgba(14,13,11,0));z-index:0}
  .clay__breathe,.clay__boil,.clay__pop{position:absolute;inset:0;transform-origin:50% 97%}
  .clay__breathe{z-index:1;animation:lp-breathe 2.6s steps(1,end) infinite}
  .clay__boil{animation:lp-boil .5s steps(1,end) infinite;animation-delay:var(--boil-delay,0s)}
  .clay img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0}
  .clay img.is-on{opacity:1}
  .clay.is-pop .clay__pop{animation:lp-pop .36s steps(1,end)}
  .clay.is-hop .clay__pop{animation:lp-hop .6s steps(1,end)}
  @keyframes lp-boil{
    0%{transform:translate(0,0) rotate(0)}
    25%{transform:translate(.7px,-.6px) rotate(.4deg)}
    50%{transform:translate(-.6px,.4px) rotate(-.3deg)}
    75%{transform:translate(.3px,.8px) rotate(.25deg)}
  }
  @keyframes lp-breathe{
    0%,100%{transform:none}
    17%{transform:scale(1.004,1.008)}
    33%{transform:scale(1.008,1.016)}
    50%{transform:scale(1.01,1.02)}
    67%{transform:scale(1.008,1.016)}
    83%{transform:scale(1.004,1.008)}
  }
  @keyframes lp-pop{
    0%{transform:scale(1.07,.9)}
    33%{transform:scale(.96,1.06)}
    66%{transform:scale(1.02,.98)}
    100%{transform:none}
  }
  @keyframes lp-hop{
    0%{transform:scale(1.08,.88)}
    17%{transform:translateY(-9%) scale(.94,1.08)}
    33%{transform:translateY(-13%) scale(.98,1.02)}
    50%{transform:translateY(-6%) scale(.97,1.05)}
    67%{transform:scale(1.09,.88)}
    83%{transform:scale(.98,1.03)}
    100%{transform:none}
  }
  /* plop in when revealed */
  :is([data-reveal],[data-reveal-stagger]):not(.is-in) .clay__pop{opacity:0}
  .is-in .clay__pop{animation:lp-plop .72s steps(1,end) backwards;animation-delay:var(--plop-delay,.15s)}
  .is-in .clay.is-pop .clay__pop{animation:lp-pop .36s steps(1,end)}
  .is-in .clay.is-hop .clay__pop{animation:lp-hop .6s steps(1,end)}
  @keyframes lp-plop{
    0%{opacity:0}
    17%{opacity:1;transform:translateY(-14%) scale(.92,1.1)}
    33%{transform:scale(1.12,.82)}
    50%{transform:scale(.95,1.07)}
    67%{transform:scale(1.03,.97)}
    83%,100%{transform:none}
  }
  @media (prefers-reduced-motion:reduce){
    .clay__breathe,.clay__boil{animation:none}
    .clay__pop,.is-in .clay__pop{animation:none!important;opacity:1!important;transform:none}
  }

  /* ---------- 1. hero ---------- */
  /* the ground takes the speaker's wash, with a faint glow of their colour behind them; registered so it eases, never cuts */
  @property --hero-bg{syntax:'<color>';inherits:true;initial-value:#e2e8f2}
  @property --hero-dot{syntax:'<color>';inherits:true;initial-value:#5b77a6}
  @property --spot-x{syntax:'<length-percentage>';inherits:true;initial-value:50%}
  .lph{padding:calc(4.5rem + clamp(2rem,5vw,4rem)) 0 clamp(3.5rem,7vw,6rem);
    background:radial-gradient(ellipse min(34rem,70vw) 24rem at var(--spot-x) 34%,color-mix(in oklab,var(--hero-bg),var(--hero-dot) 16%),transparent 72%),var(--hero-bg);
    transition:--hero-bg 1.4s var(--ease),--hero-dot 1.4s var(--ease),--spot-x 1.1s var(--ease)}
  .lph__in{display:grid;justify-items:center;gap:clamp(1.5rem,3vw,2.5rem);text-align:center}
  .lph__stage{position:relative;width:min(100%,46rem);padding-top:clamp(6.5rem,10vw,8rem)}
  .lph__line{display:flex;justify-content:center;align-items:end}
  /* whoever is talking steps forward a touch (stepped, like the rest of the clay) */
  .lph .clay--line{transition:transform .3s steps(3,end)}
  .lph .clay--line.is-talking{transform:scale(1.12);z-index:2}
  .lph__copy{display:grid;justify-items:center;gap:1.5rem}
  .lph__copy .display{font-size:clamp(3.1rem,5.6vw,5rem)}
  .lph__copy .lead{max-width:36rem}
  .lph__copy .cta-row{justify-content:center}
  .lph__copy .cta-note{margin-top:-.6rem;color:var(--ink-60)}
  /* desktop: the whole hero fits one screen. The line-up and headline size off the viewport height,
     the room above the bubble clears the nav plus the stickers. Phones and very short windows scroll as before. */
  @media (min-width:761px) and (min-height:600px){
    .lph{min-height:100vh;min-height:100svh;display:grid;align-content:center;padding:6.75rem 0 3vh}
    .lph__in{gap:min(2.5rem,3vh)}
    .lph__stage{width:min(100%,46rem,74vh);padding-top:clamp(5.5rem,12vh,8rem)}
    .lph__copy{gap:min(1.5rem,2.2vh)}
    .lph__copy .display{font-size:clamp(2.6rem,min(5.6vw,6.8vh),5rem)}
