---
/**
 * V2Footer — the delivered v2 footer, server-rendered.
 * Ported from team-july2026-multipager/js/chrome.js (footer markup + columns).
 *
 * The newsletter form posts to the same CRM endpoint the rest of the site uses
 * (admin.getteamnow.com/api/v1/website-leads, source_form='newsletter'), with
 * the same `website` honeypot. Submit handling lives in v2-chrome.js.
 *
 * Links carry an `enabled` flag; disabled ones aren't rendered and a column
 * that ends up empty is dropped rather than shown as a bare label. All are
 * currently enabled — the Platform pages landed. Keep the mechanism for the
 * next designed-but-unbuilt destination.
 */
import { DEFAULT_LOCALE, hasTranslation, localizePath, type Locale } from "../lib/i18n";

interface Link { href: string; label: string; enabled?: boolean }

interface Props {
  /**
   * Locale of the page this footer is rendered on. Destinations only — the
   * labels stay English until the pages behind them are translated.
   *
   * V2Nav got this first, and the footer not having it produced a page with
   * TWO "Pricing" links going to different language versions: the nav's to
   * /ko/pricing, the footer's to /pricing. A Korean reader who scrolled past
   * the nav was silently dropped back into English by the same site, on the
   * same page, with no indication anything had changed.
   */
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;

/** Localise an internal path if a translation exists; leave anything else alone. */
const localeHref = (path: string) =>
  path.startsWith("/") && hasTranslation(path, locale) ? localizePath(path, locale) : path;

const LOGO = "/v2/assets/logo/team-logo-live.svg";

const COLUMNS: { heading: string; links: Link[] }[] = [
  {
    heading: "Platform",
    links: [
      { href: "/rollouts", label: "Rollouts", enabled: true },
      { href: "/teammate", label: "TeamMate", enabled: true },
      { href: "/assets", label: "Assets", enabled: true },
      { href: "/connections", label: "Connections", enabled: true },
      { href: "/tours", label: "Tours", enabled: true },
    ],
  },
  {
    heading: "Solutions",
    links: [
      { href: "/for-artists", label: "Solo artists" },
      { href: "/for-managers", label: "Managers" },
      { href: "/for-labels", label: "Labels" },
      { href: "/for-partners", label: "Distributors" },
      { href: "/enterprise", label: "Enterprise" },
    ],
  },
  {
    heading: "Company",
    links: [
      { href: "/insights", label: "Insights" },
      { href: "/about", label: "About" },
      { href: "/pricing", label: "Pricing" },
      { href: "/contact", label: "Contact" },
      // Changelog is a Resources-shaped page, not a legal one. It already
      // existed and was reachable only by typing the URL — the footer is the
      // one place it belongs.
      { href: "/changelog", label: "Changelog" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/security", label: "Security" },
      // SMS compliance doc. It was live but linked from nowhere on the site,
      // which is the opposite of what a compliance page is for.
      { href: "/sms-terms", label: "SMS Terms" },
      { href: "/cookies", label: "Cookies" },
    ],
  },
];

const columns = COLUMNS.map((c) => ({
  ...c,
  links: c.links.filter((l) => l.enabled !== false),
})).filter((c) => c.links.length > 0);

const SOCIAL = [
  { href: "https://www.instagram.com/teamrollouts/", label: "Instagram", svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>' },
  { href: "https://x.com/Teamrollouts", label: "X", svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 3h3l-6.6 7.5L21.7 21h-5.9l-4.3-5.6L6.5 21H3.5l7-8L2.7 3h6l3.9 5.1zm-1 16h1.7L7.6 4.7H5.8z"/></svg>' },
  { href: "https://www.linkedin.com/company/teamrollouts", label: "LinkedIn", svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9z"/></svg>' },
];
---

<footer class="foot v2-chrome">
  <div class="foot__in">
    <div class="foot__news">
      <div class="foot__news-copy">
        <h3>Operational intelligence for <em>every release.</em></h3>
        <p>The occasional email on where music operations are heading, and what we're shipping in Team.</p>
      </div>
      <form class="foot__form" id="v2FootNews" novalidate>
        <input type="email" name="email" placeholder="you@label.com" aria-label="Email address" required />
        <input type="text" name="website" class="foot__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit">Subscribe</button>
      </form>
    </div>

    <div class="foot__grid">
      <div class="foot__brand">
        <a href="/" aria-label="Team — home"><img src={LOGO} alt="Team" /></a>
        <p>Team connects the systems your music operation already runs on, turning every tool, file, message, plan, and data point into one living intelligence layer.</p>
        <div class="foot__social">
          {SOCIAL.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} set:html={s.svg} />
          ))}
        </div>
      </div>
      {columns.map((c) => (
        <div class="foot__col">
          <p>{c.heading}</p>
          {c.links.map((l) => <a href={localeHref(l.href)}>{l.label}</a>)}
        </div>
      ))}
    </div>

    <div class="foot__bot">
      <span class="mono">© 2026 Team Rollouts</span>
      {/* Consent has to be as easy to withdraw as it was to give, so the
          re-open trigger lives here rather than buried in a settings page.
          V2CookieBanner listens for [data-cookie-prefs] anywhere on the page. */}
      <a class="mono" href="/cookies" data-cookie-prefs>Cookie preferences</a>
      <span class="mono">Operational Intelligence for Music Releases</span>
    </div>
  </div>
</footer>
