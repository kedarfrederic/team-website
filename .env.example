# Marketing site env. Copy to .env (not committed) for local dev.
#
# These two enable the Sanity Visual Editing flow:

# Read token (Viewer role) for fetching drafts in preview mode.
# Create at: manage.sanity.io → API → Tokens → Add API token (Viewer)
# REQUIRED for preview mode to show unpublished edits. If absent, preview
# falls back to the published client.
SANITY_API_READ_TOKEN=

# Shared secret that gates `/api/preview/enable`. Studio embeds this in
# the preview-mode URL so arbitrary visitors can't flip themselves into
# preview. Generate any random string (32+ chars). Must match
# SANITY_STUDIO_PREVIEW_SECRET in /sanity/.env.
SANITY_PREVIEW_SECRET=

# Hosted Studio URL for stega-encoded click-to-edit links. In dev this
# points at the local studio (http://localhost:3333); in prod, set to
# the deployed Studio URL (e.g. https://team-cms.sanity.studio).
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Editor-role token used by `npm run seed` (scripts/seed-sanity.ts) to push
# demo content into the Sanity dataset. Local-only, not used at runtime.
# Create at: manage.sanity.io → your project → API → Tokens → Add API token (Editor)
SANITY_WRITE_TOKEN=

# ---- Investor deck (/investors) ----
# Google OAuth client for deck admin sign-in. Create at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application) with redirect URI:
#   https://teamrollouts.com/api/investors/callback
# (add http://localhost:4321/api/investors/callback for local testing).
INVESTOR_GOOGLE_CLIENT_ID=
INVESTOR_GOOGLE_CLIENT_SECRET=
# Random 32+ char string; signs admin sessions, gate cookies and OAuth state.
INVESTOR_SESSION_SECRET=
# Comma list of emails and/or @domains allowed into edit mode.
# Default when unset: @teamrollouts.com,@teamforartists.com
INVESTOR_ADMIN_EMAILS=
# Dev only: set to 1 to enter edit mode without OAuth under `astro dev`.
INVESTOR_DEV_ADMIN=
